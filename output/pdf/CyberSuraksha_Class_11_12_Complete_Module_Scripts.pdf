          "practice": [
            {
              "stage": 0,
              "brief": "Offline model only: no query, scanning, exploitation or live request is performed. Exercise amount rule: whole rupees from 0 to 5,000 inclusive. Server identity, authorisation, validation and structured data access remain distinct.",
              "eyebrow": "Portal design and incident lab",
              "prompt": "Match each misuse case to its missing control.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><label class=\"matchRow\"><span>Negative amount is accepted</span><select aria-label=\"Negative amount is accepted\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Server input validation</option><option>Per-record server authorisation</option><option>Structured / parameterised data access</option></select></label><label class=\"matchRow\"><span>A signed-in participant can read a different ownerâ€™s record</span><select aria-label=\"A signed-in participant can read a different ownerâ€™s record\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Server input validation</option><option>Per-record server authorisation</option><option>Structured / parameterised data access</option></select></label><label class=\"matchRow\"><span>User text is inserted into query instructions</span><select aria-label=\"User text is inserted into query instructions\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Server input validation</option><option>Per-record server authorisation</option><option>Structured / parameterised data access</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your system assurance record</h2><ol></ol><p>Use this checked evidence alongside the earlier portal, timeline and recovery chapter records for your individual explanation. Your teacher reviews the viva separately. All tests use fictional offline models.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
                  "rows": [
                    {
                      "label": "Negative amount is accepted",
                      "answer": "Server input validation",
                      "why": "The amount must satisfy the stated range and whole-number rule."
