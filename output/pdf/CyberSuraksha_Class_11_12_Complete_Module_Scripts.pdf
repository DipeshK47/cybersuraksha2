                "heading": "Test every access route",
                "facts": [
                  "Remove former members from relevant groups",
                  "Review direct shares and public links",
                  "Test as the affected role before calling the change complete"
                ]
              },
              {
                "heading": "A smaller permission set still works",
                "facts": [
                  "Organisers can do their work",
                  "Suppliers receive only delivery information",
                  "Next: configure and test three access cases"
                ]
              }
            ],
            "task": "Dev has left. The direct share is removed but the organiser group still grants access. What should change?",
            "choices": [
              {
                "label": "Nothing: the direct share was removed",
                "why": "Group membership can still grant access. Check inherited permissions."
              },
              {
                "label": "Remove Dev from the relevant group and test again",
                "correct": true,
                "why": "Both direct and inherited access routes need review."
              },
              {
                "label": "Make the whole folder public",
                "why": "Public sharing would expose it to more people."
              }
            ]
          }
        },
