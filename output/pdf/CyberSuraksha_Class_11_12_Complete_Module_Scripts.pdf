          "source": "app/module/cyber/lessons/new/story/chapters/choose-the-right-data-model.json",
          "duration": 92.625,
          "scenes": [
            {
              "id": "choose-the-right-data-model-1",
              "label": "Meet the team",
              "title": "An operation needs a model",
              "mood": "happy",
              "caption": "Asha organises a fictional festival desk. Registrations have stable identifiers, edits need an undo history and support tickets arrive in order. The team should choose a data structure for the required operation, rather than put everything into one undifferentiated list.",
              "dialogue": "What must happen next to each item?",
              "status": "Inspect the workflow",
              "tone": "normal",
              "start": 0,
              "duration": 18.304,
              "html": "<link rel=\"preload\" as=\"image\" href=\"/cyber-missions/class-12/ct-registration-workbench.webp\"/><div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-workflow\" aria-hidden=\"true\"><rect width=\"8\" height=\"8\" x=\"3\" y=\"3\" rx=\"2\"></rect><path d=\"M7 11v4a2 2 0 0 0 2 2h4\"></path><rect width=\"8\" height=\"8\" x=\"13\" y=\"13\" rx=\"2\"></rect></svg><strong>Cyberpur Â· Class 12 reliable automation lab</strong></div><h2 style=\"margin-top:18px\">An operation needs a model</h2><figure class=\"sceneIllustration\"><img src=\"/cyber-missions/class-12/ct-registration-workbench.webp\" alt=\"Asha aligns fictional registration cards by identifier tabs while Kabir preserves conflicting duplicates and a teacher points out an unmatched card.\" width=\"1400\" height=\"788\" decoding=\"async\"/><figcaption>Use stable identity and preserve unresolved evidence. A name match is not enough to merge records.</figcaption></figure><small class=\"note\">Synthetic records and offline models only. No real registrations, notifications, messages or service changes.</small></div>"
            },
            {
              "id": "choose-the-right-data-model-2",
              "label": "The problem",
              "title": "Different orders mean different behaviour",
              "mood": "surprise",
              "caption": "An ordered list preserves a sequence. A keyed lookup retrieves by a unique stable ID. A stack removes the latest added item first; a queue serves the earliest waiting item first. A name is not necessarily a unique key.",
              "dialogue": "Undo and first-come support need different removal orders.",
              "status": "Risk unresolved",
              "tone": "trouble",
              "start": 18.954,
              "duration": 15.296,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-workflow\" aria-hidden=\"true\"><rect width=\"8\" height=\"8\" x=\"3\" y=\"3\" rx=\"2\"></rect><path d=\"M7 11v4a2 2 0 0 0 2 2h4\"></path><rect width=\"8\" height=\"8\" x=\"13\" y=\"13\" rx=\"2\"></rect></svg><strong>Cyberpur Â· Class 12 reliable automation lab</strong></div><h2 style=\"margin-top:18px\">Different orders mean different behaviour</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-workflow\" aria-hidden=\"true\"><rect width=\"8\" height=\"8\" x=\"3\" y=\"3\" rx=\"2\"></rect><path d=\"M7 11v4a2 2 0 0 0 2 2h4\"></path><rect width=\"8\" height=\"8\" x=\"13\" y=\"13\" rx=\"2\"></rect></svg><strong>Desk operation cards Â· synthetic exercise</strong></div><div class=\"artifactRow\"><span>Ordered programme</span><strong>List Â· position is not identity</strong></div><div class=\"artifactRow\"><span>Registration record</span><strong>Stable-key lookup after conflicts resolved</strong></div><div class=\"artifactRow\"><span>Undo U1, U2, U3</span><strong>Next removal U3 Â· stack</strong></div><div class=\"artifactRow\"><span>Support T1, T2, T3</span><strong>Next removal T1 Â· queue</strong></div></div><small class=\"note\">Synthetic records and offline models only. No real registrations, notifications, messages or service changes.</small></div>"
            },
            {
              "id": "choose-the-right-data-model-3",
              "label": "How it works",
              "title": "Trace the next operation",
              "mood": "thinking",
              "caption": "The undo stack contains U1, U2 and then U3. The latest action is U3. The support queue contains T1, T2 and then T3; T1 is served next. These are abstract operation rules, not measurements of a particular implementation.",
              "dialogue": "Predict, run and inspect the remaining items.",
              "status": "Build the contract",
              "tone": "normal",
              "start": 34.9,
              "duration": 17.301,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-workflow\" aria-hidden=\"true\"><rect width=\"8\" height=\"8\" x=\"3\" y=\"3\" rx=\"2\"></rect><path d=\"M7 11v4a2 2 0 0 0 2 2h4\"></path><rect width=\"8\" height=\"8\" x=\"13\" y=\"13\" rx=\"2\"></rect></svg><strong>Cyberpur Â· Class 12 reliable automation lab</strong></div><h2 style=\"margin-top:18px\">Trace the next operation</h2><div class=\"storyFacts\"><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Ordered list and stable-key lookup serve different operations</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Stack: latest first; queue: earliest waiting first</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Duplicate identity and priority-policy changes need human review</span></div></div><small class=\"note\">Synthetic records and offline models only. No real registrations, notifications, messages or service changes.</small></div>"
            },
