          "practice": [
            {
              "stage": 0,
              "brief": "Protect sign-in and recovery together. Authentication checks identity; authorisation limits what that identity can do. Never enter real passwords or recovery codes here.",
              "eyebrow": "Festival team security lab",
              "prompt": "Protect Asha's fictional festival account.",
              "html": "<section><div class=\"illustratedActivity\"><figure class=\"sceneIllustration\"><img src=\"/cyber-missions/class-11/account-access.webp\" alt=\"A student reviews people and folder permissions on a laptop beside a sign-in phone, a separate envelope and a locked drawer.\" width=\"1400\" height=\"788\" decoding=\"async\" loading=\"lazy\"/><figcaption>The team reviews who can sign in, what they can open and how access can be recovered privately.</figcaption></figure><div class=\"senior\"><div class=\"board\"><label class=\"checkRow\"><input type=\"checkbox\"/><span>A different long password stored in a password manager</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>MFA or a supported passkey; keep recovery options available</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>Recovery codes stored privately away from the sign-in phone</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>Put the password and recovery codes in the team group</span></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>Test protection</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your evidence record</h2><ol></ol><p>Use this record to explain your decisions to your teacher. Your explanation is reviewed separately from the automatic checks.</p></div>",
              "interactions": [
                {
                  "type": "ControlChecklist",
                  "controls": [
                    {
                      "id": "unique",
                      "label": "A different long password stored in a password manager",
                      "good": true,
                      "why": "A leak from another service should not unlock this one."
                    },
                    {
                      "id": "mfa",
                      "label": "MFA or a supported passkey; keep recovery options available",
                      "good": true,
                      "why": "Add protection beyond a reusable password and plan for a lost device."
                    },
                    {
                      "id": "recovery",
                      "label": "Recovery codes stored privately away from the sign-in phone",
                      "good": true,
                      "why": "Recovery must still be available after the phone is lost."
                    },
                    {
                      "id": "share",
                      "label": "Put the password and recovery codes in the team group",
                      "good": false,
                      "why": "A shared group is not private credential storage. Use individual accounts and assigned roles."
                    }
                  ],
                  "success": "Account plan: unique password, an additional sign-in protection and private recovery independent of the sign-in phone."
                }
              ]
            },
            {
              "stage": 1,
              "brief": "Protect sign-in and recovery together. Authentication checks identity; authorisation limits what that identity can do. Never enter real passwords or recovery codes here.",
              "eyebrow": "Festival team security lab",
              "prompt": "The sign-in phone is lost. Rehearse recovery without the phone.",
              "html": "<section><div class=\"senior\"><div class=\"senior\"><div class=\"board\"><ol class=\"sequence\" aria-label=\"Your action sequence\"><li><b>1</b>Choose the next action below</li><li><b>2</b>Choose the next action below</li><li><b>3</b>Choose the next action below</li><li><b>4</b>Choose the next action below</li></ol><div class=\"actionBank\"><button type=\"button\" class=\"choice\">Review sessions and revoke the lost device&#x27;s access</button><button type=\"button\" class=\"choice\">Open the provider&#x27;s known recovery page on a trusted device</button><button type=\"button\" class=\"choice\">Set up the replacement sign-in method and refresh recovery options</button><button type=\"button\" class=\"choice\">Use a privately stored recovery method to prove account ownership</button></div><div class=\"controls\"><button type=\"button\" class=\"secondary\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-rotate-ccw\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8\"></path><path d=\"M3 3v5h5\"></path></svg>Undo last action</button><button type=\"button\" class=\"primary\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play\" aria-hidden=\"true\"><polygon points=\"6 3 20 12 6 21 6 3\"></polygon></svg>Run sequence</button></div></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your evidence record</h2><ol></ol><p>Use this record to explain your decisions to your teacher. Your explanation is reviewed separately from the automatic checks.</p></div>",
              "interactions": [
                {
                  "type": "SequenceBoard",
                  "steps": [
                    "Open the provider's known recovery page on a trusted device",
                    "Use a privately stored recovery method to prove account ownership",
                    "Review sessions and revoke the lost device's access",
                    "Set up the replacement sign-in method and refresh recovery options"
                  ],
                  "success": "Recovery test: known provider page â†’ private ownership check â†’ revoke lost-device sessions â†’ restore sign-in and recovery options."
                }
              ]
            },
            {
              "stage": 2,
              "brief": "Protect sign-in and recovery together. Authentication checks identity; authorisation limits what that identity can do. Never enter real passwords or recovery codes here.",
              "eyebrow": "Festival team security lab",
              "prompt": "A new supplier can sign in. Does that mean they may edit every file?",
              "html": "<section><div class=\"senior\"><div class=\"senior\"><div class=\"board\"><label class=\"matchRow\"><span>The service verifies Asha&#x27;s passkey</span><select aria-label=\"The service verifies Asha&#x27;s passkey\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Authorisation</option><option>Authentication</option></select></label><label class=\"matchRow\"><span>Asha may edit registration records but a guest may only view the programme</span><select aria-label=\"Asha may edit registration records but a guest may only view the programme\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Authorisation</option><option>Authentication</option></select></label><label class=\"matchRow\"><span>A signed-in former supplier cannot open the private folder</span><select aria-label=\"A signed-in former supplier cannot open the private folder\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Authorisation</option><option>Authentication</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your evidence record</h2><ol></ol><p>Use this record to explain your decisions to your teacher. Your explanation is reviewed separately from the automatic checks.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
                  "rows": [
                    {
                      "label": "The service verifies Asha's passkey",
                      "answer": "Authentication",
                      "why": "Authentication checks who is signing in."
                    },
                    {
                      "label": "Asha may edit registration records but a guest may only view the programme",
                      "answer": "Authorisation",
                      "why": "Authorisation controls what an identified person can do."
                    },
                    {
                      "label": "A signed-in former supplier cannot open the private folder",
                      "answer": "Authorisation",
                      "why": "A successful sign-in does not grant access to every resource."
                    }
                  ],
                  "options": [
                    "Authorisation",
                    "Authentication"
                  ],
                  "success": "Authentication establishes identity. Authorisation grants only the actions and resources that identity needs."
                }
              ]
            }
          ],
          "decisionTask": {
            "title": "Kabir's missing sign-in phone",
            "icon": {},
            "panels": [
              {
                "heading": "The festival account needs its organiser",
                "facts": [
                  "Kabir uses an individual account",
                  "A password manager stores a unique password",
                  "His phone provides the second sign-in factor"
                ]
              },
              {
                "heading": "The phone is missing",
                "facts": [
                  "Kabir still knows the official service address",
                  "A recovery code exists",
                  "But where was that code stored?"
                ]
              },
              {
                "heading": "Plan for losing the sign-in device",
                "facts": [
                  "Password: long and unique",
                  "MFA or a supported passkey: stronger sign-in",
                  "Recovery: private and available independently of the lost phone"
                ]
              },
              {
                "heading": "Choose a usable recovery route",
                "facts": [
                  "The old phone is unavailable",
                  "The team group includes suppliers",
                  "An offline recovery code is stored privately"
                ]
              },
              {
                "heading": "Recover, then review",
                "facts": [
                  "Use the known provider's recovery process",
                  "Review and revoke the lost device's sessions",
                  "Register the replacement method and refresh recovery options"
                ]
              },
              {
                "heading": "Identity is only the first question",
                "facts": [
                  "Authentication: is this Kabir?",
                  "Authorisation: what may Kabir access?",
                  "Next: test protection, recovery and access decisions"
                ]
              }
            ],
            "task": "Where should a recovery code be available if the sign-in phone is lost?",
            "choices": [
              {
                "label": "Only in a screenshot on that phone",
                "why": "That copy is unavailable with the phone. Recovery must survive the loss."
              },
              {
                "label": "In the festival's public group",
                "why": "A recovery code can grant account access. Keep it private."
              },
              {
                "label": "In private storage independent of that phone",
                "correct": true,
                "why": "Recovery stays private and survives the lost device."
              }
            ]
          }
        },
