              "text": "baseline"
            },
            {
              "line": 123,
              "kind": "Exact text",
              "text": "Task, baseline, costs and acceptance criteria set before the reveal"
            },
            {
              "line": 123,
              "kind": "Exact text",
              "text": "A metric should answer a pre-specified decision question."
