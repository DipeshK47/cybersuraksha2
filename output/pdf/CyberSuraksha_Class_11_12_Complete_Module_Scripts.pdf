            },
            {
              "id": "what-to-do-after-a-loss-2",
              "label": "The problem",
              "title": "Do not wait for a perfect file",
              "mood": "surprise",
              "caption": "For an actual financial cyber fraud in India, contact the bank or payment provider immediately through a trusted channel. Seek a trusted adultâ€™s help and promptly use nineteen thirty or the National Cyber Crime Reporting Portal. Do not delay urgent contact to finish screenshots.",
              "dialogue": "Start urgent contact while preserving the evidence you have.",
              "status": "Evidence unresolved",
              "tone": "trouble",
              "start": 15.626,
              "duration": 17.792,
