              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><label class=\"matchRow\"><span>Public export Â· supplied likelihood 3 Ã— impact 3 = 9</span><select aria-label=\"Public export Â· supplied likelihood 3 Ã— impact 3 = 9\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>First: registration lead restricts export access</option><option>Second: operations lead tests the gate fallback</option><option>Third: communications lead keeps an approved original</option></select></label><label class=\"matchRow\"><span>Single gate device Â· supplied likelihood 2 Ã— impact 3 = 6</span><select aria-label=\"Single gate device Â· supplied likelihood 2 Ã— impact 3 = 6\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>First: registration lead restricts export access</option><option>Second: operations lead tests the gate fallback</option><option>Third: communications lead keeps an approved original</option></select></label><label class=\"matchRow\"><span>Editable public poster Â· supplied likelihood 1 Ã— impact 2 = 2</span><select aria-label=\"Editable public poster Â· supplied likelihood 1 Ã— impact 2 = 2\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>First: registration lead restricts export access</option><option>Second: operations lead tests the gate fallback</option><option>Third: communications lead keeps an approved original</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></section>",
