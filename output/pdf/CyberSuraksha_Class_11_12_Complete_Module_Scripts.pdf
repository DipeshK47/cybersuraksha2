          "practice": [
            {
              "stage": 0,
              "brief": "Inspect a fictional college offer. Urgency, authority, scarcity, secrecy and reward are warning signals. A signal calls for verification; it does not prove fraud by itself.",
              "eyebrow": "Evidence and verification lab",
              "prompt": "Map the five persuasion tactics.",
              "html": "<section><div class=\"lab illustratedActivity\"><figure class=\"sceneIllustration\"><img src=\"/cyber-missions/class-11/fraud-offer-desk.webp\" alt=\"Asha pauses before handing over an identity envelope while Kabir compares an internship offer with an independent source and a teacher helps nearby.\" width=\"1400\" height=\"788\" decoding=\"async\" loading=\"lazy\"/><figcaption>Compare the exact offer with an independent source before sharing documents or money.</figcaption></figure><div class=\"senior\"><div class=\"board\"><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><strong>College-place offer Â· simulation</strong></div><div class=\"artifactRow\"><span>Deadline</span><strong>Five minutes</strong></div><div class=\"artifactRow\"><span>Claimed authority</span><strong>Admissions director</strong></div><div class=\"artifactRow\"><span>Availability / reward</span><strong>Two places Â· guaranteed stipend</strong></div><div class=\"artifactRow\"><span>Instruction</span><strong>Keep secret and pay now</strong></div><div class=\"artifactRow\"><span>Evidence status</span><strong>Unverified sender and claim</strong></div></div><div class=\"board\"><label class=\"matchRow\"><span>â€œPay in five minutes or lose the placeâ€</span><select aria-label=\"â€œPay in five minutes or lose the placeâ€\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Urgency</option><option>Authority</option><option>Scarcity</option><option>Secrecy</option><option>Reward</option></select></label><label class=\"matchRow\"><span>â€œThe admissions director selected youâ€</span><select aria-label=\"â€œThe admissions director selected youâ€\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Urgency</option><option>Authority</option><option>Scarcity</option><option>Secrecy</option><option>Reward</option></select></label><label class=\"matchRow\"><span>â€œOnly two places remainâ€</span><select aria-label=\"â€œOnly two places remainâ€\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Urgency</option><option>Authority</option><option>Scarcity</option><option>Secrecy</option><option>Reward</option></select></label><label class=\"matchRow\"><span>â€œDo not tell your teacher or familyâ€</span><select aria-label=\"â€œDo not tell your teacher or familyâ€\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Urgency</option><option>Authority</option><option>Scarcity</option><option>Secrecy</option><option>Reward</option></select></label><label class=\"matchRow\"><span>â€œA guaranteed â‚¹40,000 stipend awaitsâ€</span><select aria-label=\"â€œA guaranteed â‚¹40,000 stipend awaitsâ€\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Urgency</option><option>Authority</option><option>Scarcity</option><option>Secrecy</option><option>Reward</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your verification evidence record</h2><ol></ol><p>Structured decisions are checked automatically. Your teacher reviews the actual portfolio, individual defence and reflection. All case records are fictional.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
                  "rows": [
                    {
                      "label": "â€œPay in five minutes or lose the placeâ€",
                      "answer": "Urgency",
                      "why": "The deadline pushes action before checking."
                    },
                    {
                      "label": "â€œThe admissions director selected youâ€",
                      "answer": "Authority",
                      "why": "A claimed position borrows institutional trust without verifying the sender."
                    },
                    {
                      "label": "â€œOnly two places remainâ€",
                      "answer": "Scarcity",
                      "why": "Limited availability pressures the decision."
                    },
                    {
                      "label": "â€œDo not tell your teacher or familyâ€",
                      "answer": "Secrecy",
                      "why": "Isolation blocks another person from checking the claim."
                    },
                    {
                      "label": "â€œA guaranteed â‚¹40,000 stipend awaitsâ€",
                      "answer": "Reward",
                      "why": "An attractive outcome can distract from verification."
                    }
                  ],
                  "options": [
                    "Urgency",
                    "Authority",
                    "Scarcity",
                    "Secrecy",
                    "Reward"
                  ],
                  "success": "Persuasion map: five-minute deadline â†’ urgency; admissions director â†’ authority; two places â†’ scarcity; keep secret â†’ secrecy; guaranteed stipend â†’ reward. These signals call for independent verification, not a verdict from one phrase."
                }
              ]
            },
            {
              "stage": 1,
              "brief": "Inspect a fictional college offer. Urgency, authority, scarcity, secrecy and reward are warning signals. A signal calls for verification; it does not prove fraud by itself.",
              "eyebrow": "Evidence and verification lab",
              "prompt": "Choose a response that follows the evidence.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><div class=\"actionBank\"><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Pay a small amount before checking</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Pause, preserve the message and independently locate the college contact</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Declare every deadline fraudulent</button></div><button type=\"button\" class=\"primary\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check decision</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your verification evidence record</h2><ol></ol><p>Structured decisions are checked automatically. Your teacher reviews the actual portfolio, individual defence and reflection. All case records are fictional.</p></div>",
              "interactions": [
                {
                  "type": "ChoiceTask",
                  "choices": [
                    "Pay a small amount before checking",
                    "Pause, preserve the message and independently locate the college contact",
                    "Declare every deadline fraudulent"
                  ],
                  "answer": 1,
                  "feedback": "A pressure signal alone is not proof. Pause and verify the particular claim through a route not chosen by its sender.",
                  "success": "Verification action: preserve the message and check the specific offer through an independently located college contact. The claim remains unverified until supported; a deadline alone does not prove fraud."
                }
              ]
            },
            {
              "stage": 2,
              "brief": "Inspect a fictional college offer. Urgency, authority, scarcity, secrecy and reward are warning signals. A signal calls for verification; it does not prove fraud by itself.",
              "eyebrow": "Evidence and verification lab",
              "prompt": "Transfer the same method to a new notice.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><label class=\"matchRow\"><span>A real school notice has a deadline</span><select aria-label=\"A real school notice has a deadline\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Warning sign alone is not proof</option><option>Use an independently located college contact</option><option>Pause and involve a trusted adult</option></select></label><label class=\"matchRow\"><span>A stranger claims to represent the college</span><select aria-label=\"A stranger claims to represent the college\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Warning sign alone is not proof</option><option>Use an independently located college contact</option><option>Pause and involve a trusted adult</option></select></label><label class=\"matchRow\"><span>A message demands secrecy before payment</span><select aria-label=\"A message demands secrecy before payment\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Warning sign alone is not proof</option><option>Use an independently located college contact</option><option>Pause and involve a trusted adult</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your verification evidence record</h2><ol></ol><p>Structured decisions are checked automatically. Your teacher reviews the actual portfolio, individual defence and reflection. All case records are fictional.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
                  "rows": [
                    {
                      "label": "A real school notice has a deadline",
                      "answer": "Warning sign alone is not proof",
                      "why": "Deadlines occur in legitimate notices too; inspect the claim and source."
                    },
                    {
                      "label": "A stranger claims to represent the college",
                      "answer": "Use an independently located college contact",
                      "why": "The sender cannot supply both the claim and its only verification."
                    },
                    {
                      "label": "A message demands secrecy before payment",
                      "answer": "Pause and involve a trusted adult",
                      "why": "Remove isolation before deciding about money or identity documents."
                    }
                  ],
                  "options": [
                    "Warning sign alone is not proof",
                    "Use an independently located college contact",
                    "Pause and involve a trusted adult"
                  ],
                  "success": "Transfer: a deadline alone is not proof; a claimed representative needs independent college verification; secrecy before payment calls for a pause and trusted-adult support."
                }
              ]
            }
          ],
          "decisionTask": {
            "title": "Asha spots the pressure",
            "concepts": [
              "Urgency, authority, scarcity, secrecy, reward",
              "A warning sign is not proof by itself",
              "Pause and verify through a separate trusted route"
            ],
            "question": "The offer asks for a payment in five minutes. What is a supported next step?",
            "choices": [
              "Pay now to avoid missing out",
              "Pause and check through an independently located college contact",
              "Publicly accuse the named organisation without checking"
            ],
            "answer": 1,
            "why": "A pressured claim needs independent verification; neither paying nor publicly accusing is supported by the message alone."
          }
        },
