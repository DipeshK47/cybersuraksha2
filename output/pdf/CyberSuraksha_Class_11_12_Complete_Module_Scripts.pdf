            {
              "id": "the-evidence-hearing-4",
              "label": "Your decision",
              "title": "Choose the supported decision",
              "mood": "thinking",
              "caption": "Should Kabir accuse the collector from the flag, share a PIN because one receipt is genuine, or preserve the benign context while independently verifying the separate caller and keeping secrets private?",
              "dialogue": "One supported fact does not verify every request.",
