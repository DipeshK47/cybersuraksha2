          "entries": [
            {
              "line": 3,
              "kind": "Exact text",
              "text": "Preserve a programmeâ€™s item order and read a known position"
            },
            {
              "line": 3,
              "kind": "Exact text",
              "text": "Ordered list"
            },
            {
              "line": 3,
              "kind": "Exact text",
              "text": "A list preserves sequence; a position is different from an identity key."
            },
            {
              "line": 4,
              "kind": "Exact text",
              "text": "Retrieve a uniquely identified registration by stable ID"
            },
            {
              "line": 4,
              "kind": "Exact text",
              "text": "Keyed lookup"
            },
            {
              "line": 4,
              "kind": "Exact text",
              "text": "Resolve duplicate IDs before trusting a unique lookup."
            },
            {
              "line": 5,
              "kind": "Exact text",
              "text": "Undo the most recently added edit first"
            },
            {
              "line": 5,
              "kind": "Exact text",
              "text": "Stack Â· last in, first out"
            },
            {
              "line": 5,
              "kind": "Exact text",
              "text": "Undo follows the most recent action before earlier ones."
            },
            {
              "line": 6,
              "kind": "Exact text",
              "text": "Serve the earliest waiting support ticket first"
            },
            {
              "line": 6,
              "kind": "Exact text",
              "text": "Queue Â· first in, first out"
            },
            {
              "line": 6,
              "kind": "Exact text",
              "text": "A queue expresses first-come ordering, not a priority policy."
            },
            {
              "line": 13,
              "kind": "Exact text",
              "text": "Two records have the same stable ID"
            },
            {
              "line": 13,
              "kind": "Exact text",
              "text": "Flag the conflict before unique-key lookup"
            },
            {
              "line": 13,
              "kind": "Exact text",
              "text": "A convenient map must not silently overwrite unresolved records."
            },
            {
              "line": 14,
              "kind": "Exact text",
              "text": "A new urgent-priority policy is proposed"
            },
            {
              "line": 14,
              "kind": "Exact text",
              "text": "Seek authorised policy review; FIFO alone cannot decide priority"
            },
            {
              "line": 14,
              "kind": "Exact text",
              "text": "A data structure implements a rule but does not authorise a change."
            },
            {
              "line": 15,
              "kind": "Exact text",
              "text": "One item changes position in a list"
            },
            {
              "line": 15,
              "kind": "Exact text",
              "text": "Its stable identity should not depend on the old position"
            },
            {
              "line": 15,
              "kind": "Exact text",
              "text": "A position may change as other items are inserted or removed."
            },
            {
              "line": 18,
              "kind": "Exact text",
              "text": "One known-position indexed read, after data preparation"
            },
            {
              "line": 18,
              "kind": "Exact text",
              "text": "Constant Â· O(1) counted access"
            },
            {
              "line": 18,
              "kind": "Exact text",
              "text": "The counted access does not grow with n under this model."
            },
            {
              "line": 19,
              "kind": "Exact text",
              "text": "Binary search on an already sorted list"
            },
            {
              "line": 19,
              "kind": "Exact text",
              "text": "Logarithmic Â· O(log n) record probes"
            },
            {
              "line": 19,
              "kind": "Exact text",
              "text": "Each step reduces the remaining ordered interval."
            },
            {
              "line": 20,
              "kind": "Exact text",
              "text": "Last-item linear search in an n-item list"
            },
            {
              "line": 20,
              "kind": "Exact text",
              "text": "Linear Â· O(n) record probes"
            },
            {
              "line": 20,
              "kind": "Exact text",
              "text": "This trace visits every record once."
            },
            {
              "line": 21,
              "kind": "Exact text",
              "text": "Compare every unordered pair of n distinct records"
            },
            {
              "line": 21,
              "kind": "Exact text",
              "text": "Quadratic Â· O(nÂ²) pair comparisons"
            },
            {
              "line": 21,
              "kind": "Exact text",
              "text": "The exact n(nâˆ’1)/2 comparisons grow quadratically."
            },
            {
              "line": 24,
              "kind": "Exact text",
              "text": "Use a classroom size from 0 to 1024"
            },
            {
              "line": 32,
              "kind": "Exact text",
              "text": "The list is shuffled before binary search"
            },
            {
              "line": 32,
              "kind": "Exact text",
              "text": "Establish and verify sorted order; include preparation when comparing total work"
            },
            {
              "line": 32,
              "kind": "Exact text",
              "text": "Binary search cannot discard a half-range without an ordering guarantee."
            },
            {
              "line": 33,
              "kind": "Exact text",
              "text": "The direct-read count is one"
            },
            {
              "line": 33,
              "kind": "Exact text",
              "text": "Known position and prepared indexed representation are assumed"
            },
            {
              "line": 33,
              "kind": "Exact text",
              "text": "One indexed read is not one search for an unknown identity."
            },
            {
              "line": 34,
              "kind": "Exact text",
              "text": "A hash-based lookup is called constant time"
            },
            {
              "line": 34,
              "kind": "Exact text",
              "text": "State expected-average assumptions and include index construction/storage"
            },
            {
              "line": 34,
              "kind": "Exact text",
              "text": "Hash behaviour and preparation matter; it is not a universal worst-case promise."
            },
            {
              "line": 35,
              "kind": "Exact text",
              "text": "One algorithm has fewer counted probes"
            },
            {
              "line": 35,
              "kind": "Exact text",
              "text": "Do not claim elapsed-time superiority without measuring the relevant system"
            },
            {
              "line": 35,
              "kind": "Exact text",
              "text": "I/O, implementation and other work are excluded from this simple count."
            },
