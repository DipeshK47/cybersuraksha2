          "practice": [
            {
              "stage": 0,
              "brief": "Training examples shape predictions; held-out examples evaluate them. This tiny nearest-example classifier uses invented numerical features and is not a real material detector.",
              "eyebrow": "Festival AI evaluation lab",
              "prompt": "Match learning tasks to their methods.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><label class=\"matchRow\"><span>Learn Paper/Metal labels from labelled examples</span><select aria-label=\"Learn Paper/Metal labels from labelled examples\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Clustering</option><option>Regression</option><option>Supervised classification</option></select></label><label class=\"matchRow\"><span>Group similar examples without supplied group labels</span><select aria-label=\"Group similar examples without supplied group labels\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Clustering</option><option>Regression</option><option>Supervised classification</option></select></label><label class=\"matchRow\"><span>Predict a numerical queue length from past measurements</span><select aria-label=\"Predict a numerical queue length from past measurements\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Clustering</option><option>Regression</option><option>Supervised classification</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your AI evaluation record</h2><ol></ol><p>Use this evidence for your teacherâ€™s individual review. The automatic checks assess structured decisions, not the quality of an oral defence.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
                  "rows": [
                    {
                      "label": "Learn Paper/Metal labels from labelled examples",
                      "answer": "Supervised classification",
                      "why": "Classification learns a category prediction using supplied labels."
                    },
                    {
                      "label": "Group similar examples without supplied group labels",
                      "answer": "Clustering",
