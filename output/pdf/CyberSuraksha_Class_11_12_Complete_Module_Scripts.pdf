          "practice": [
            {
              "stage": 0,
              "brief": "Annual capstone lesson 2 of 2: concise team briefing, individual fresh decision and reflection. A receipt explains one payment path while a separate caller asks for a PIN. Keep supported context separate from unverified authority. Teacher reviews actual briefing, authorship and oral defence.",
              "eyebrow": "Private evidence and response lab",
              "prompt": "Order a concise evidence-led team briefing.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><ol class=\"sequence\" aria-label=\"Your action sequence\"><li><b>1</b>Choose the next action below</li><li><b>2</b>Choose the next action below</li><li><b>3</b>Choose the next action below</li><li><b>4</b>Choose the next action below</li></ol><div class=\"actionBank\"><button type=\"button\" class=\"choice\">Name remaining unknowns and a plausible alternative explanation</button><button type=\"button\" class=\"choice\">State confirmed facts separately from claims and inference</button><button type=\"button\" class=\"choice\">State restricted evidence handling, follow-up review and an improvement action</button><button type=\"button\" class=\"choice\">Describe containment, verification and support with named responsible roles</button></div><div class=\"controls\"><button type=\"button\" class=\"secondary\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-rotate-ccw\" aria-hidden=\"true\"><path d=\"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8\"></path><path d=\"M3 3v5h5\"></path></svg>Undo last action</button><button type=\"button\" class=\"primary\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play\" aria-hidden=\"true\"><polygon points=\"6 3 20 12 6 21 6 3\"></polygon></svg>Run sequence</button></div></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your prevention and response case file</h2><ol></ol><p>Structured decisions are checked automatically. Your teacher reviews the actual case dossier, team briefing, individual defence and reflection. All records are fictional; no real contact, transfer or report occurs.</p></div>",
              "interactions": [
                {
                  "type": "SequenceBoard",
                  "steps": [
                    "State confirmed facts separately from claims and inference",
                    "Describe containment, verification and support with named responsible roles",
                    "Name remaining unknowns and a plausible alternative explanation",
                    "State restricted evidence handling, follow-up review and an improvement action"
                  ],
                  "success": "Team-briefing outline: confirmed facts separate from claims; containment/verification/support with responsible roles; remaining unknowns and an alternative explanation; restricted evidence, follow-up and an improvement action. The actual team briefing is reviewed by the teacher, not automatically graded as delivered."
                }
              ]
            },
            {
              "stage": 1,
              "brief": "Annual capstone lesson 2 of 2: concise team briefing, individual fresh decision and reflection. A receipt explains one payment path while a separate caller asks for a PIN. Keep supported context separate from unverified authority. Teacher reviews actual briefing, authorship and oral defence.",
              "eyebrow": "Private evidence and response lab",
              "prompt": "Analyse the fresh receipt-plus-caller case without an allegation.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-folder-search\" aria-hidden=\"true\"><path d=\"M10.7 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v4.1\"></path><path d=\"m21 21-1.9-1.9\"></path><circle cx=\"17\" cy=\"17\" r=\"3\"></circle></svg><strong>Fresh evidence-hearing case Â· fictional case</strong></div><div class=\"artifactRow\"><span>Supported context</span><strong>RP1 explains Câ€™s group purchase</strong></div><div class=\"artifactRow\"><span>Unsupported allegation</span><strong>A pass-through flag proves intent</strong></div><div class=\"artifactRow\"><span>Separate request</span><strong>Another caller asks for a PIN</strong></div><div class=\"artifactRow\"><span>Decision boundary</span><strong>Receipt does not verify caller or authorise secret disclosure</strong></div></div><div class=\"board\"><label class=\"matchRow\"><span>Independent receipt supports a group purchase through C</span><select aria-label=\"Independent receipt supports a group purchase through C\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Supported benign context for that payment path</option><option>Unsupported allegation</option><option>Unsafe disclosure request; decline and verify independently</option><option>Nothing sufficient about that separate identity/authority claim</option></select></label><label class=\"matchRow\"><span>Pass-through flag is said to prove C intended fraud</span><select aria-label=\"Pass-through flag is said to prove C intended fraud\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Supported benign context for that payment path</option><option>Unsupported allegation</option><option>Unsafe disclosure request; decline and verify independently</option><option>Nothing sufficient about that separate identity/authority claim</option></select></label><label class=\"matchRow\"><span>Separate caller asks for a PIN</span><select aria-label=\"Separate caller asks for a PIN\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Supported benign context for that payment path</option><option>Unsupported allegation</option><option>Unsafe disclosure request; decline and verify independently</option><option>Nothing sufficient about that separate identity/authority claim</option></select></label><label class=\"matchRow\"><span>What the receipt establishes about the caller</span><select aria-label=\"What the receipt establishes about the caller\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Supported benign context for that payment path</option><option>Unsupported allegation</option><option>Unsafe disclosure request; decline and verify independently</option><option>Nothing sufficient about that separate identity/authority claim</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your prevention and response case file</h2><ol></ol><p>Structured decisions are checked automatically. Your teacher reviews the actual case dossier, team briefing, individual defence and reflection. All records are fictional; no real contact, transfer or report occurs.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
                  "rows": [
                    {
                      "label": "Independent receipt supports a group purchase through C",
                      "answer": "Supported benign context for that payment path",
                      "why": "The receipt supports this purpose without verifying unrelated requests."
                    },
                    {
                      "label": "Pass-through flag is said to prove C intended fraud",
                      "answer": "Unsupported allegation",
                      "why": "A pattern does not establish intent, and the supplied context gives an innocent explanation."
                    },
                    {
                      "label": "Separate caller asks for a PIN",
                      "answer": "Unsafe disclosure request; decline and verify independently",
                      "why": "A genuine receipt does not authorise the caller or secret disclosure."
                    },
                    {
                      "label": "What the receipt establishes about the caller",
                      "answer": "Nothing sufficient about that separate identity/authority claim",
                      "why": "Do not combine independent claims into one blanket trust decision."
                    }
                  ],
                  "options": [
                    "Supported benign context for that payment path",
                    "Unsupported allegation",
                    "Unsafe disclosure request; decline and verify independently",
                    "Nothing sufficient about that separate identity/authority claim"
                  ],
                  "success": "Fresh-case analysis: RP1 supports Câ€™s group-purchase context; a flag does not establish intent; the separate PIN request is unsafe and should be declined/verified independently; the genuine receipt is insufficient evidence of that callerâ€™s identity or authority. Preserve benign context without combining unrelated trust claims."
                }
              ]
            },
            {
              "stage": 2,
              "brief": "Annual capstone lesson 2 of 2: concise team briefing, individual fresh decision and reflection. A receipt explains one payment path while a separate caller asks for a PIN. Keep supported context separate from unverified authority. Teacher reviews actual briefing, authorship and oral defence.",
              "eyebrow": "Private evidence and response lab",
              "prompt": "Save an individual decision, improvement plan and labelled dossier sources.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><fieldset class=\"portfolio\"><legend>Four-strand case dossier</legend><p>Show your earlier records to your teacher or honestly label the supplied case-pack replacements. Source labels and the short reflection are saved with the submitted response in teacher history.</p><div class=\"portfolioRow\"><a href=\"/module/cyber/security-assurance-review?grade=12\" target=\"_blank\" rel=\"noreferrer\">Open system risk chapter</a><p>Supplied replacement: Confirmed export exposure; authorised restriction and scope review</p><label class=\"matchRow\"><span>System risk source</span><select><option value=\"\" selected=\"\">Label the sourceâ€¦</option><option value=\"earlier\">My earlier work, to show my teacher</option><option value=\"supplied\">Supplied case pack</option></select></label></div><div class=\"portfolioRow\"><a href=\"/module/cyber/ai-go-revise-stop-review?grade=12\" target=\"_blank\" rel=\"noreferrer\">Open ai evidence chapter</a><p>Supplied replacement: Uncited voice-authenticity claim is unsupported</p><label class=\"matchRow\"><span>AI evidence source</span><select><option value=\"\" selected=\"\">Label the sourceâ€¦</option><option value=\"earlier\">My earlier work, to show my teacher</option><option value=\"supplied\">Supplied case pack</option></select></label></div><div class=\"portfolioRow\"><a href=\"/module/cyber/retest-after-a-change?grade=12\" target=\"_blank\" rel=\"noreferrer\">Open algorithm checks chapter</a><p>Supplied replacement: Conflicting same-ID amounts held; old/new evidence retained</p><label class=\"matchRow\"><span>Algorithm checks source</span><select><option value=\"\" selected=\"\">Label the sourceâ€¦</option><option value=\"earlier\">My earlier work, to show my teacher</option><option value=\"supplied\">Supplied case pack</option></select></label></div><div class=\"portfolioRow\"><a href=\"/module/cyber/design-prevention-that-can-be-tested?grade=12\" target=\"_blank\" rel=\"noreferrer\">Open fraud response chapter</a><p>Supplied replacement: Tested independent verification and prompt private help routes</p><label class=\"matchRow\"><span>Fraud response source</span><select><option value=\"\" selected=\"\">Label the sourceâ€¦</option><option value=\"earlier\">My earlier work, to show my teacher</option><option value=\"supplied\">Supplied case pack</option></select></label></div><label class=\"noteLabel\">Dossier reflection for teacher review<textarea maxLength=\"300\" rows=\"4\" placeholder=\"Use fictional details. State evidence, an uncertainty and one improvement.\"></textarea></label><small>Up to 300 characters. Meaning, actual evidence and authorship are reviewed by your teacher; text length is not automatically graded.</small></fieldset><label class=\"matchRow\"><span>Individual fresh-case decision</span><select><option value=\"\" selected=\"\">Chooseâ€¦</option><option value=\"accuse\">Accuse C and share the PIN because the receipt is genuine</option><option value=\"verify\">Keep benign context, decline secrets/transfer and independently verify the separate caller; seek prompt trusted help if misused</option></select></label><label class=\"matchRow\"><span>Improvement plan</span><select><option value=\"\" selected=\"\">Chooseâ€¦</option><option value=\"hide\">Hide the unsafe attempt and delete the awkward case</option><option value=\"test\">Add this missed case to the aid tests, clarify the known verification route and assign a review owner</option></select></label><label class=\"matchRow\"><span>Preparation assistance disclosure</span><select><option value=\"\" selected=\"\">Choose what is true for your preparationâ€¦</option><option value=\"lab\">Prepared lab and supplied case pack only</option><option value=\"assisted\">Additional assistance; I will identify my contribution and what I verified to my teacher</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Save evidence-hearing decision</button><p class=\"micro\">Give a concise team briefing and an individual defence: evidence, alternative, uncertainty, safe action and improvement. The teacher reviews actual work and oral understanding. Automatic marks cover structured checks, not the whole annual assessment.</p></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your prevention and response case file</h2><ol></ol><p>Structured decisions are checked automatically. Your teacher reviews the actual case dossier, team briefing, individual defence and reflection. All records are fictional; no real contact, transfer or report occurs.</p></div>",
              "interactions": []
            }
          ],
          "decisionTask": {
            "title": "The evidence hearing",
            "concepts": [
              "State facts, claims, actions, owners and uncertainty",
              "A benign receipt does not authorise a separate PIN request",
              "Teacher reviews the team briefing, individual defence and reflection"
            ],
            "question": "A receipt explains Câ€™s purchase, but a separate caller asks for a PIN. What is supported?",
            "choices": [
              "Accuse C from the pattern flag",
              "Share the PIN because the receipt is real",
              "Keep the benign context, decline secret disclosure and independently verify the separate caller"
            ],
            "answer": 2,
            "why": "The receipt supports one purpose, not unrelated identity or authority. Do not accuse from a flag or share a PIN to verify someone."
          }
        }
      ],
