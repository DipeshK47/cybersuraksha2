          "entries": [
            {
              "line": 3,
              "kind": "Exact text",
              "text": "â€œPay in five minutes or lose the placeâ€"
            },
            {
              "line": 3,
              "kind": "Exact text",
              "text": "Urgency"
            },
            {
              "line": 3,
              "kind": "Exact text",
              "text": "The deadline pushes action before checking."
            },
            {
              "line": 4,
              "kind": "Exact text",
              "text": "â€œThe admissions director selected youâ€"
            },
            {
              "line": 4,
              "kind": "Exact text",
              "text": "Authority"
            },
            {
              "line": 4,
              "kind": "Exact text",
              "text": "A claimed position borrows institutional trust without verifying the sender."
            },
            {
              "line": 5,
              "kind": "Exact text",
              "text": "â€œOnly two places remainâ€"
            },
            {
              "line": 5,
              "kind": "Exact text",
              "text": "Scarcity"
            },
            {
              "line": 5,
              "kind": "Exact text",
              "text": "Limited availability pressures the decision."
            },
            {
              "line": 6,
              "kind": "Exact text",
              "text": "â€œDo not tell your teacher or familyâ€"
            },
            {
              "line": 6,
              "kind": "Exact text",
              "text": "Secrecy"
            },
            {
              "line": 6,
              "kind": "Exact text",
              "text": "Isolation blocks another person from checking the claim."
            },
            {
              "line": 7,
              "kind": "Exact text",
              "text": "â€œA guaranteed â‚¹40,000 stipend awaitsâ€"
            },
            {
              "line": 7,
              "kind": "Exact text",
              "text": "Reward"
            },
            {
              "line": 7,
              "kind": "Exact text",
              "text": "An attractive outcome can distract from verification."
            },
            {
              "line": 10,
              "kind": "Exact text",
              "text": "A real school notice has a deadline"
            },
            {
              "line": 10,
              "kind": "Exact text",
              "text": "Warning sign alone is not proof"
            },
            {
              "line": 10,
              "kind": "Exact text",
              "text": "Deadlines occur in legitimate notices too; inspect the claim and source."
            },
            {
              "line": 11,
              "kind": "Exact text",
              "text": "A stranger claims to represent the college"
            },
            {
              "line": 11,
              "kind": "Exact text",
              "text": "Use an independently located college contact"
            },
            {
              "line": 11,
              "kind": "Exact text",
              "text": "The sender cannot supply both the claim and its only verification."
            },
            {
              "line": 12,
              "kind": "Exact text",
              "text": "A message demands secrecy before payment"
            },
            {
              "line": 12,
              "kind": "Exact text",
              "text": "Pause and involve a trusted adult"
            },
            {
              "line": 12,
              "kind": "Exact text",
              "text": "Remove isolation before deciding about money or identity documents."
            },
            {
              "line": 15,
              "kind": "Exact text",
              "text": "Offer Â· sender"
