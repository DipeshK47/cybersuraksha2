          "decisionTask": {
            "title": "Kabir checks the investment story",
            "concepts": [
              "Check exact entity, role, channel and claim",
              "Endorsement images and copied references are insufficient",
              "Verification never promises returns or recovery"
            ],
            "question": "The unverified app demands another release fee. What is supported?",
            "choices": [
              "Pay to test the withdrawal",
              "Trust the celebrity image",
              "Pause and reject unsupported payment instructions; verify independently"
            ],
            "answer": 2,
            "why": "An endorsement or registry-looking reference does not verify the app or release fee. Use independent sources without treating registration as a safety guarantee."
          }
        },
