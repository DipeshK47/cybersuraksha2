            {
              "stage": 2,
              "brief": "Linear search can inspect unsorted data. Binary search needs sorted order. Count comparisons for this pack and remember that sorting preparation also costs work.",
              "eyebrow": "Scholarship workflow logic lab",
              "prompt": "Choose methods for a new enquiry situation and explain preparation cost.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><label class=\"matchRow\"><span>One enquiry in a tiny unsorted list; no existing index</span><select aria-label=\"One enquiry in a tiny unsorted list; no existing index\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Linear search can avoid sorting</option><option>Binary search fits the precondition</option><option>State that sorting cost is excluded</option></select></label><label class=\"matchRow\"><span>Many lookups in an already sorted ID list</span><select aria-label=\"Many lookups in an already sorted ID list\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Linear search can avoid sorting</option><option>Binary search fits the precondition</option><option>State that sorting cost is excluded</option></select></label><label class=\"matchRow\"><span>Compare 5 linear checks with 2 binary checks</span><select aria-label=\"Compare 5 linear checks with 2 binary checks\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Linear search can avoid sorting</option><option>Binary search fits the precondition</option><option>State that sorting cost is excluded</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your algorithm evidence record</h2><ol></ol><p>Use the trace, expected outcomes and revisions to explain your reasoning. Your teacher reviews the individual defence separately.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
                  "rows": [
                    {
                      "label": "One enquiry in a tiny unsorted list; no existing index",
                      "answer": "Linear search can avoid sorting",
                      "why": "Sorting preparation may outweigh the benefit for one small lookup."
                    },
                    {
                      "label": "Many lookups in an already sorted ID list",
                      "answer": "Binary search fits the precondition",
                      "why": "Sorted order already exists and repeated lookups can benefit from narrowing the range."
                    },
                    {
                      "label": "Compare 5 linear checks with 2 binary checks",
                      "answer": "State that sorting cost is excluded",
                      "why": "Lookup counts alone do not include preparing the sorted list."
                    }
                  ],
                  "options": [
                    "Linear search can avoid sorting",
                    "Binary search fits the precondition",
                    "State that sorting cost is excluded"
                  ],
                  "success": "Method choice: one tiny unsorted enquiry can use linear search; many lookups in an already sorted list fit binary search; comparing 5 with 2 checks must explicitly exclude sorting preparation."
                }
              ]
            }
