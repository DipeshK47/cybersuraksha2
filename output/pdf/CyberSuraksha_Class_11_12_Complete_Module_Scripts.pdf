          ],
          "decisionTask": {
            "title": "Asha's festival risk desk",
            "icon": {},
            "panels": [
              {
                "heading": "One festival. Three things to protect.",
                "facts": [
                  "Registration list Â· private contact details",
                  "Payment sheet Â· accurate supplier amounts",
                  "Gate laptop Â· available when visitors arrive"
                ]
              },
              {
                "heading": "The link escaped the team",
                "facts": [
                  "Registrations.csv: anyone with the link can view",
                  "A supplier forwards the link to a public group",
                  "Student contact details could be copied"
                ]
              },
              {
                "heading": "Describe the chain",
                "facts": [
                  "Asset: the registration list",
                  "Threat: an unauthorised person downloads it",
                  "Vulnerability: public-link sharing",
                  "Control: named access for organisers"
                ]
              },
              {
                "heading": "What is the weakness?",
                "facts": [
                  "The registration list contains information worth protecting.",
                  "A harmful download is a possible event.",
                  "Find the setting that makes that event easier."
                ]
              },
              {
                "heading": "Now the team can act",
                "facts": [
                  "Restrict the link to named organisers",
                  "Check what was exposed with the teacher",
                  "Record what is known and what remains uncertain"
                ]
              },
              {
                "heading": "Protect more than secrecy",
                "facts": [
                  "Confidentiality: who can see contacts?",
                  "Integrity: who can change amounts?",
                  "Availability: will the gate system work?",
                  "Next: build and prioritise your risk register"
                ]
              }
            ],
            "task": "Choose the vulnerability in the registration-list case.",
            "choices": [
              {
                "label": "The registration list",
                "why": "The list is the asset. Which setting makes unwanted access possible?"
              },
              {
                "label": "Anyone-with-link sharing",
                "correct": true,
                "why": "The open sharing setting is the vulnerability."
              },
              {
                "label": "An unauthorised download",
                "why": "That is a threat event. Identify the weakness it could use."
              }
            ]
          }
        },
        {
