              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><label class=\"matchRow\"><span>Input contract</span><select aria-label=\"Input contract\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Original records preserved; stable ID, category and supplied score</option><option>A plus two digits; supported category; finite score 0â€“100; conflicts held</option><option>Score â‰¥70 â†’ Review; lower valid score â†’ Record only</option><option>Ledger keyed by event ID, quarantine reasons and pending/checkpoint log</option></select></label><label class=\"matchRow\"><span>Validation contract</span><select aria-label=\"Validation contract\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Original records preserved; stable ID, category and supplied score</option><option>A plus two digits; supported category; finite score 0â€“100; conflicts held</option><option>Score â‰¥70 â†’ Review; lower valid score â†’ Record only</option><option>Ledger keyed by event ID, quarantine reasons and pending/checkpoint log</option></select></label><label class=\"matchRow\"><span>Transformation contract</span><select aria-label=\"Transformation contract\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Original records preserved; stable ID, category and supplied score</option><option>A plus two digits; supported category; finite score 0â€“100; conflicts held</option><option>Score â‰¥70 â†’ Review; lower valid score â†’ Record only</option><option>Ledger keyed by event ID, quarantine reasons and pending/checkpoint log</option></select></label><label class=\"matchRow\"><span>Output contract</span><select aria-label=\"Output contract\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Original records preserved; stable ID, category and supplied score</option><option>A plus two digits; supported category; finite score 0â€“100; conflicts held</option><option>Score â‰¥70 â†’ Review; lower valid score â†’ Record only</option><option>Ledger keyed by event ID, quarantine reasons and pending/checkpoint log</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your automation evidence record</h2><ol></ol><p>Use the checked records across the module for your teacherâ€™s individual review. Automatic checks assess structured decisions, not authorship or the oral defence. All traces are fictional offline models.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
                  "rows": [
                    {
                      "label": "Input contract",
                      "answer": "Original records preserved; stable ID, category and supplied score",
                      "why": "The pipeline must retain the source and distinguish supplied from invented data."
                    },
                    {
                      "label": "Validation contract",
                      "answer": "A plus two digits; supported category; finite score 0â€“100; conflicts held",
                      "why": "Missing, invalid and conflicting data need visible routes."
                    },
