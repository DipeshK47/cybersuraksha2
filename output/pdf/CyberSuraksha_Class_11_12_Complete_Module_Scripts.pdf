            {
              "line": 137,
              "kind": "Exact text",
              "text": "Notify the authorised lead, preserve records and restrict exposure through the operator"
            },
            {
              "line": 137,
              "kind": "Exact text",
              "text": "Accuse the account holder publicly"
            },
            {
              "line": 137,
              "kind": "Exact text",
              "text": "Use authorised coordinated containment and evidence preservation, without destroying records or making unsupported accusations."
            },
            {
              "line": 138,
              "kind": "Exact text",
              "text": "Asha verifies recovery"
