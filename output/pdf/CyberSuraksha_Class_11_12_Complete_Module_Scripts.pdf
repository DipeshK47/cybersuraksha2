            {
              "stage": 2,
              "brief": "Synthetic dirty tables: one expected check-in per registration. Stable IDs link tables; names are not unique. Preserve repeated/conflicting rows and unmatched references; no check-in record means attendance unknown.",
              "eyebrow": "Reliable automation lab",
              "prompt": "Choose an evidence-preserving correction and human handoff.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><div class=\"actionBank\"><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Merge every Riya row because names match</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Preserve stable IDs and original rows; hold conflicts/unmatched references for authorised review and retest the repaired relationship</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Keep the last conflicting value and delete the earlier evidence</button></div><button type=\"button\" class=\"primary\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check decision</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your automation evidence record</h2><ol></ol><p>Use the checked records across the module for your teacherâ€™s individual review. Automatic checks assess structured decisions, not authorship or the oral defence. All traces are fictional offline models.</p></div>",
              "interactions": [
                {
                  "type": "ChoiceTask",
                  "choices": [
                    "Merge every Riya row because names match",
                    "Preserve stable IDs and original rows; hold conflicts/unmatched references for authorised review and retest the repaired relationship",
                    "Keep the last conflicting value and delete the earlier evidence"
                  ],
                  "answer": 1,
                  "feedback": "Names are not unique identity keys. Preserve conflicting and unmatched evidence; a missing check-in is unknown, not proof of absence.",
                  "success": "Reconciliation decision: keep R02 and R03 distinct; preserve original rows and the unresolved R01/R02/R05 cases, seek authorised corrections and retest key uniqueness/reference coverage. R03 attendance remains unknown without check-in evidence."
                }
              ]
            }
          ],
          "decisionTask": {
            "title": "Asha reconciles the registrations",
            "concepts": [
              "Stable IDs link records; names need not be unique",
              "Preserve conflicts, repeats and unmatched references",
              "No check-in row means unknown attendance"
            ],
            "question": "How should two Riya records and conflicting ID values be handled?",
            "choices": [
              "Merge all names and keep the latest value",
              "Reconcile by stable ID and preserve unresolved cases for authorised review",
              "Assume anyone missing a check-in was absent"
            ],
            "answer": 1,
            "why": "Names are not unique identifiers, last-write wins hides evidence and missing check-in evidence does not prove absence."
          }
        },
