            {
              "id": "check-the-investment-story-2",
              "label": "The problem",
              "title": "A borrowed name and a release fee",
              "mood": "surprise",
              "caption": "The offer uses a firm name and a copied-looking registration reference, but its app domain does not match the independently supplied contact. When withdrawal is requested, the sender demands another release fee. Neither an endorsement image nor a matching name verifies that request.",
              "dialogue": "A registry match is not a safety guarantee.",
              "status": "Claim unresolved",
              "tone": "trouble",
              "start": 17.461,
              "duration": 17.707,
