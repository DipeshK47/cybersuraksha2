          "title": "Asha measures two searches",
          "character": "Asha",
          "beginLabel": "Enter the logic lab",
          "waitingText": "Story paused. Trace the reasoning and test your decision.",
          "lockedHint": "Complete the workflow decision first.",
          "source": "app/module/cyber/lessons/new/story/chapters/search-and-sort-with-purpose.json",
