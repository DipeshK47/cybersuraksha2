              "prompt": "Handle a role confirmed while the claimant/request remain unresolved.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-folder-search\" aria-hidden=\"true\"><path d=\"M10.7 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v4.1\"></path><path d=\"m21 21-1.9-1.9\"></path><circle cx=\"17\" cy=\"17\" r=\"3\"></circle></svg><strong>Independent identity protocol Â· fictional case</strong></div><div class=\"artifactRow\"><span>Claimant</span><strong>Familiar voice/profile/title; secrecy and new verification number</strong></div><div class=\"artifactRow\"><span>Known office route</span><strong>Previously saved school careers-office contact</strong></div><div class=\"artifactRow\"><span>Separate contact pack</span><strong>Independently supplied organisation channel</strong></div><div class=\"artifactRow\"><span>Partial result</span><strong>Role exists; claimant and private request remain unverified</strong></div></div><div class=\"board\"><div class=\"actionBank\"><button type=\"button\" class=\"choice\" aria-pressed=\"false\">The advertised role exists, but this claimant and private payment/document request remain unverified</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">A real role means every caller using its name is authorised</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">An unanswered callback counts as confirmation</button></div><button type=\"button\" class=\"primary\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check decision</button></div></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your prevention and response case file</h2><ol></ol><p>Structured decisions are checked automatically. Your teacher reviews the actual case dossier, team briefing, individual defence and reflection. All records are fictional; no real contact, transfer or report occurs.</p></div>",
              "interactions": [
                {
                  "type": "ChoiceTask",
                  "choices": [
                    "The advertised role exists, but this claimant and private payment/document request remain unverified",
                    "A real role means every caller using its name is authorised",
                    "An unanswered callback counts as confirmation"
                  ],
                  "answer": 0,
                  "feedback": "Update only the fact confirmed by the independent office. Role existence does not authenticate this claimant or authorise payment/document disclosure.",
                  "success": "Identity protocol result: independently supplied office confirms role existence only. Claimant identity and the private money/document request remain unresolved; keep them paused, use known independent contacts and trusted-adult escalation. One unanswered check is not confirmation."
                }
              ]
            }
          ],
          "decisionTask": {
            "title": "Asha verifies manufactured authority",
            "concepts": [
              "Sound, image and title are signals, not sufficient authority",
              "Two claimant-supplied channels are not independent",
              "Confirm the exact request; retain unresolved claims"
            ],
            "question": "Which identity check is independent?",
            "choices": [
              "Previously known careers-office route plus independently supplied organisation contact",
              "The callerâ€™s new verification number",
              "A smaller ID scan sent as a test"
            ],
            "answer": 0,
            "why": "Verify outside the suspicious channel using routes known independently of the claimant. A test disclosure is still disclosure."
          }
