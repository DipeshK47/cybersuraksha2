            {
              "line": 118,
              "kind": "Exact text",
              "text": "scope"
            },
            {
              "line": 118,
              "kind": "Exact text",
              "text": "Use only appropriately authorised data/materials and credit the sources"
            },
            {
              "line": 118,
              "kind": "Exact text",
              "text": "Attribution and permission/scope are separate checks."
            },
            {
              "line": 119,
              "kind": "Exact text",
              "text": "gap"
            },
            {
              "line": 119,
              "kind": "Exact text",
              "text": "Record group counts and investigate causes with fresh evidence after revision"
            },
            {
              "line": 119,
              "kind": "Exact text",
              "text": "The small observed gap does not by itself establish its cause or general fairness."
            },
            {
              "line": 120,
              "kind": "Exact text",
              "text": "public"
            },
            {
              "line": 120,
              "kind": "Exact text",
              "text": "Assume any publicly visible material can be reused without checking its permitted scope"
            },
            {
              "line": 120,
              "kind": "Exact text",
              "text": "Visibility and citation alone do not establish permission or suitability."
            },
            {
              "line": 123,
