            {
              "line": 138,
              "kind": "Exact text",
              "text": "No; test completeness, access and the stated recovery objectives"
            },
            {
              "line": 138,
              "kind": "Exact text",
              "text": "Copy completion alone does not establish service behaviour, clean permissions or the exercise recovery targets."
            },
            {
              "line": 139,
              "kind": "Exact text",
              "text": "The security assurance board"
            },
            {
              "line": 139,
              "kind": "Exact text",
              "text": "Balance privacy, usability and cost"
            },
            {
              "line": 139,
              "kind": "Exact text",
              "text": "Revise only the conclusion the new evidence changes"
