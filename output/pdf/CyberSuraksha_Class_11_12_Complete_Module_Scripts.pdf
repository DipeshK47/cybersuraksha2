                    {
                      "label": "Choose settings or operating point before final evaluation",
                      "answer": "Validation",
                      "why": "Use development evidence without consuming the final test."
                    },
                    {
                      "label": "Evaluate the frozen candidate on independent cases",
                      "answer": "Final test",
                      "why": "Keep the final outcomes out of training and setting selection."
