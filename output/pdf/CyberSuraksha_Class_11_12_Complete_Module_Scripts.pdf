            {
              "stage": 1,
              "brief": "Choose rules, learned predictions or generated drafts from the task. Exact arithmetic and verified lookups can be sufficient. Generated language still needs evidence.",
              "eyebrow": "Festival AI evaluation lab",
              "prompt": "Run the stated ticket-bill rule and explain why it fits.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><p class=\"callout\">Ticket price: â‚¹20. No discount. Change the quantity and run the explicit rule. Then check the required case: 3 tickets.</p><label class=\"matchRow\"><span>Try a quantity</span><select><option>1</option><option selected=\"\">3</option><option>5</option></select></label><button type=\"button\" class=\"secondary\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play\" aria-hidden=\"true\"><polygon points=\"6 3 20 12 6 21 6 3\"></polygon></svg>Run bill rule</button><label class=\"matchRow\"><span>Total for exactly 3 tickets (â‚¹)</span><input type=\"number\" min=\"0\" value=\"\"/></label><label class=\"matchRow\"><span>Why use this approach?</span><select><option value=\"\" selected=\"\">Choose a reasonâ€¦</option><option value=\"rule\">The fixed prices define exact arithmetic</option><option value=\"guess\">A generated estimate is always more accurate</option></select></label><button class=\"primary\" type=\"button\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Save approach evidence</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your AI evaluation record</h2><ol></ol><p>Use this evidence for your teacherâ€™s individual review. The automatic checks assess structured decisions, not the quality of an oral defence.</p></div>",
              "interactions": []
            },
            {
              "stage": 2,
              "brief": "Choose rules, learned predictions or generated drafts from the task. Exact arithmetic and verified lookups can be sufficient. Generated language still needs evidence.",
              "eyebrow": "Festival AI evaluation lab",
              "prompt": "A policy question is absent from the source pack. Choose the next action.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><div class=\"actionBank\"><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Let the assistant invent the missing policy</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Ask the organising teacher through the known school route; mark the answer as unestablished</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Treat a confident answer as the official policy</button></div><button type=\"button\" class=\"primary\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check decision</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your AI evaluation record</h2><ol></ol><p>Use this evidence for your teacherâ€™s individual review. The automatic checks assess structured decisions, not the quality of an oral defence.</p></div>",
              "interactions": [
                {
                  "type": "ChoiceTask",
                  "choices": [
                    "Let the assistant invent the missing policy",
                    "Ask the organising teacher through the known school route; mark the answer as unestablished",
                    "Treat a confident answer as the official policy"
                  ],
                  "answer": 1,
                  "feedback": "The source pack does not answer the question. A generated response cannot establish a missing official policy; use the responsible known source.",
                  "success": "Transfer decision: the policy is not established by the pack. Ask the responsible teacher through a known route and keep the uncertainty visible."
                }
              ]
            }
          ],
