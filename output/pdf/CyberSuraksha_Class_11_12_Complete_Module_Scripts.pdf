            {
              "line": 133,
              "kind": "Exact text",
              "text": "DNS and HTTPS do not grant database access"
            },
            {
              "line": 133,
              "kind": "Exact text",
              "text": "Where should permission to read a private registration be enforced?"
            },
            {
              "line": 133,
              "kind": "Exact text",
              "text": "On the server using trusted session and record data"
