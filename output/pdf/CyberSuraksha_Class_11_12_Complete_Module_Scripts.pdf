            },
            {
              "line": 133,
              "kind": "Exact text",
              "text": "In a shared password sent to everyone"
            },
            {
              "line": 133,
              "kind": "Exact text",
              "text": "The server owns enforcement; a client-controlled role or hidden button cannot be the final access check."
            },
            {
              "line": 134,
              "kind": "Exact text",
              "text": "Asha repairs the design"
            },
            {
              "line": 134,
              "kind": "Exact text",
              "text": "Validate the input range"
            },
            {
              "line": 134,
              "kind": "Exact text",
              "text": "Authorise the actorâ€™s action on this record"
            },
            {
              "line": 134,
              "kind": "Exact text",
              "text": "Keep query values as data; retest the failing pack"
            },
            {
              "line": 134,
              "kind": "Exact text",
              "text": "A valid-looking ID belongs to another participant. Which control is required?"
            },
            {
              "line": 134,
              "kind": "Exact text",
