            {
              "line": 125,
              "kind": "Exact text",
              "text": "errors"
            },
            {
              "line": 125,
              "kind": "Exact text",
              "text": "Confusion counts, threshold tradeoff, group counts and shift limitations"
            },
            {
              "line": 125,
              "kind": "Exact text",
              "text": "A single accuracy percentage hides important limits."
            },
            {
              "line": 126,
              "kind": "Exact text",
