            {
              "stage": 2,
              "brief": "Tiny prepared groups: full-text A and abbreviated/alternative-format B, ten cases each with five true staff-review cases. Compare recall and record limits without inferring a universal cause or fairness conclusion.",
              "eyebrow": "AI evidence and assurance lab",
              "prompt": "Choose accessible, appropriately authorised and testable safeguards.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><label class=\"checkRow\"><input type=\"checkbox\"/><span>Retain an accessible manual/staff route and involve affected users in review</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>Use only appropriately authorised data/materials and credit the sources</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>Record group counts and investigate causes with fresh evidence after revision</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>Assume any publicly visible material can be reused without checking its permitted scope</span></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>Test protection</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your AI assurance record</h2><ol></ol><p>Use this checked record with the moduleâ€™s baseline, manifest, calculations and model card for your teacherâ€™s individual review. Automatic checks assess structured decisions, not authorship or the oral defence. All results are prepared classroom evidence.</p></div>",
              "interactions": [
                {
                  "type": "ControlChecklist",
                  "controls": [
                    {
                      "id": "access",
                      "label": "Retain an accessible manual/staff route and involve affected users in review",
                      "good": true,
                      "why": "Users need a workable route even when predictions are unsuitable."
                    },
                    {
                      "id": "scope",
                      "label": "Use only appropriately authorised data/materials and credit the sources",
                      "good": true,
                      "why": "Attribution and permission/scope are separate checks."
                    },
                    {
                      "id": "gap",
                      "label": "Record group counts and investigate causes with fresh evidence after revision",
                      "good": true,
                      "why": "The small observed gap does not by itself establish its cause or general fairness."
                    },
                    {
                      "id": "public",
                      "label": "Assume any publicly visible material can be reused without checking its permitted scope",
                      "good": false,
                      "why": "Visibility and citation alone do not establish permission or suitability."
                    }
                  ],
                  "success": "Mitigation plan: retain an accessible staff/manual route, involve affected users, use appropriately authorised data/materials with attribution, record group denominators and independently retest revisions. Public visibility or a citation alone does not establish permitted reuse or suitability; the observed gap does not establish its cause."
                }
              ]
            }
          ],
          "decisionTask": {
            "title": "Asha reviews who is missed",
            "concepts": [
              "Group A recall 4/5; group B recall 2/5",
              "Tiny samples do not establish cause or general fairness",
              "Accessible manual route, model card and stop-use owner"
            ],
            "question": "What follows from the weak group result?",
            "choices": [
              "Hide group B from the report",
              "Document the gap, involve users and collect fresh independent evidence after revision",
              "Assume the users are inherently unsuitable"
            ],
            "answer": 1,
            "why": "The gap is an observed limit in this pack. Investigate with affected users, improve the workflow and retain accessible alternatives without making unsupported causal claims."
          }
