            },
            {
              "line": 134,
              "kind": "Exact text",
              "text": "Per-record server authorisation"
            },
            {
              "line": 134,
              "kind": "Exact text",
              "text": "An HTTPS icon alone"
            },
            {
              "line": 134,
              "kind": "Exact text",
              "text": "Valid input and transport protection cannot authorise access to another participantâ€™s record."
            },
            {
              "line": 135,
              "kind": "Exact text",
              "text": "Kabir assesses the dependencies"
            },
            {
              "line": 135,
              "kind": "Exact text",
              "text": "Programme task â†’ programme-only access"
