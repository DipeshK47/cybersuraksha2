          "scenes": [
            {
              "id": "repair-the-dataset-1",
              "label": "Meet the team",
              "title": "The sample collection",
              "mood": "happy",
              "caption": "Kabir receives a tiny synthetic dataset for the sorting experiment. Each record should have an identifier, an observed material and a label supported by the supplied description. The collection looks tidy until the team inspects individual rows.",
              "dialogue": "A table can look clean and still mislead us.",
              "status": "Planning the experiment",
              "tone": "normal",
              "start": 0,
              "duration": 15.573,
              "html": "<link rel=\"preload\" as=\"image\" href=\"/cyber-missions/class-11/ai-sorting-lab.webp\"/><div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg><strong>Cyberpur Â· Class 11 AI experiment</strong></div><h2 style=\"margin-top:18px\">The sample collection</h2><figure class=\"sceneIllustration\"><img src=\"/cyber-missions/class-11/ai-sorting-lab.webp\" alt=\"Asha and Kabir compare paper, metal and plastic practice samples with a laptop classifier at a school festival workbench.\" width=\"1400\" height=\"788\" decoding=\"async\"/><figcaption>The team changes examples, checks predictions and keeps a person responsible for the result.</figcaption></figure><small class=\"note\">Fictional examples and prepared outputs. No private records or external AI account required.</small></div>"
            },
            {
              "id": "repair-the-dataset-2",
              "label": "The problem",
              "title": "Hidden faults",
              "mood": "surprise",
              "caption": "One observed paper sample is labelled metal. A repeated record would be counted twice. Another row has no observed material, so nobody can justify a material label. The collection also contains only bright photographs.",
              "dialogue": "Which changes are supported by evidence?",
              "status": "Checking the problem",
              "tone": "trouble",
              "start": 16.223,
              "duration": 14.784,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg><strong>Cyberpur Â· Class 11 AI experiment</strong></div><h2 style=\"margin-top:18px\">Hidden faults</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-flask-conical\" aria-hidden=\"true\"><path d=\"M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2\"></path><path d=\"M6.453 15h11.094\"></path><path d=\"M8.5 2h7\"></path></svg><strong>Synthetic data audit</strong></div><div class=\"artifactRow\"><span>S1</span><strong>Metal: Supplied description: a paper sheet</strong></div><div class=\"artifactRow\"><span>S2</span><strong>Metal: Supplied description: a metal can</strong></div><div class=\"artifactRow\"><span>S3</span><strong>Paper: Material observation is missing; original unavailable</strong></div><div class=\"artifactRow\"><span>S4</span><strong>Plastic: Supplied description: a plastic bottle</strong></div></div><small class=\"note\">Fictional examples and prepared outputs. No private records or external AI account required.</small></div>"
            },
            {
              "id": "repair-the-dataset-3",
              "label": "How it works",
              "title": "Repair without inventing",
              "mood": "thinking",
              "caption": "Correct a label only when the supplied observation supports the correction. Remove a proven duplicate while preserving the original record. Quarantine an unresolved row rather than inventing its value. Record the decision and the dataset limits.",
              "dialogue": "Unknown is more honest than a made-up answer.",
              "status": "Understanding the method",
              "tone": "normal",
              "start": 31.657,
              "duration": 16.107,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg><strong>Cyberpur Â· Class 11 AI experiment</strong></div><h2 style=\"margin-top:18px\">Repair without inventing</h2><div class=\"storyFacts\"><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Correct only what observations support</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>A repeated record is different from a similar sample</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Quarantine missing evidence instead of inventing values</span></div></div><small class=\"note\">Fictional examples and prepared outputs. No private records or external AI account required.</small></div>"
            },
            {
              "id": "repair-the-dataset-4",
              "label": "Your decision",
              "title": "The missing field",
              "mood": "thinking",
              "caption": "A row has no observation of its material. The team cannot inspect the original sample. Choose what to do before this row is used for training. Do not guess simply to make every cell look complete.",
              "dialogue": "What can we honestly record here?",
              "status": "Your turn",
              "tone": "normal",
              "start": 48.414,
              "duration": 13.525,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg><strong>Cyberpur Â· Class 11 AI experiment</strong></div><h2 style=\"margin-top:18px\">The missing field</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-flask-conical\" aria-hidden=\"true\"><path d=\"M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2\"></path><path d=\"M6.453 15h11.094\"></path><path d=\"M8.5 2h7\"></path></svg><strong>Synthetic data audit</strong></div><div class=\"artifactRow\"><span>S1</span><strong>Metal: Supplied description: a paper sheet</strong></div><div class=\"artifactRow\"><span>S2</span><strong>Metal: Supplied description: a metal can</strong></div><div class=\"artifactRow\"><span>S3</span><strong>Paper: Material observation is missing; original unavailable</strong></div><div class=\"artifactRow\"><span>S4</span><strong>Plastic: Supplied description: a plastic bottle</strong></div></div><div class=\"board\"><p class=\"storyQuestion\"><strong>A material observation is missing and the original sample is unavailable. What should happen?</strong></p><div class=\"actionBank\"><button class=\"primary\" type=\"button\" aria-pressed=\"false\">Quarantine it for review</button><button class=\"primary\" type=\"button\" aria-pressed=\"false\">Guess the most common material</button><button class=\"primary\" type=\"button\" aria-pressed=\"false\">Copy the label from a nearby row</button></div><button class=\"primary\" disabled=\"\" type=\"button\">Test my decision</button></div><small class=\"note\">Fictional examples and prepared outputs. No private records or external AI account required.</small></div>"
            },
            {
              "id": "repair-the-dataset-5",
              "label": "What changes",
              "title": "A change log",
              "mood": "happy",
              "caption": "The team fixes the supported label, handles the duplicate and puts the unresolved row aside for review. Its data card says the tiny collection covers bright conditions only. Repairing a table does not make it representative of every situation.",
              "dialogue": "Every correction needs a reason we can trace.",
              "status": "Reviewing the evidence",
              "tone": "resolved",
              "start": 62.589,
              "duration": 15.829,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-database\" aria-hidden=\"true\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M3 5V19A9 3 0 0 0 21 19V5\"></path><path d=\"M3 12A9 3 0 0 0 21 12\"></path></svg><strong>Cyberpur Â· Class 11 AI experiment</strong></div><h2 style=\"margin-top:18px\">A change log</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-flask-conical\" aria-hidden=\"true\"><path d=\"M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2\"></path><path d=\"M6.453 15h11.094\"></path><path d=\"M8.5 2h7\"></path></svg><strong>Synthetic data audit</strong></div><div class=\"artifactRow\"><span>S1</span><strong>Paper: Supplied description: a paper sheet</strong></div><div class=\"artifactRow\"><span>S2</span><strong>Metal: Supplied description: a metal can</strong></div><div class=\"artifactRow\"><span>S3</span><strong>Quarantine: Material observation is missing; original unavailable</strong></div><div class=\"artifactRow\"><span>S4</span><strong>Plastic: Supplied description: a plastic bottle</strong></div></div><small class=\"note\">Fictional examples and prepared outputs. No private records or external AI account required.</small></div>"
            },
            {
              "id": "repair-the-dataset-6",
              "label": "Enter the lab",
              "title": "Enter the lab",
              "mood": "happy",
              "caption": "Repair labels, distinguish a true duplicate from a separate sample and review the collection strategy for dim conditions. Keep a quality log and a limitation instead of claiming the small dataset is ready for general use.",
              "dialogue": "Let us repair the evidence, not decorate the table.",
              "status": "Ready to practise",
              "tone": "resolved",
              "start": 79.069,
