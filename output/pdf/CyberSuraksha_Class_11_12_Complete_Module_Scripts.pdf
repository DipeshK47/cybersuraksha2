              "evidence": "<div class=\"evidence\"><h2>Your AI evaluation record</h2><ol></ol><p>Use this evidence for your teacherâ€™s individual review. The automatic checks assess structured decisions, not the quality of an oral defence.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
                  "rows": [
                    {
                      "label": "S1 repeated with the identical observation and source record",
                      "answer": "Remove proven duplicate",
                      "why": "This repeats the same record and would otherwise count one example twice."
                    },
                    {
                      "label": "S8: a separate paper sample with its own source record",
                      "answer": "Keep separate sample",
                      "why": "Two similar objects are not automatically duplicate records."
                    },
                    {
                      "label": "S9: the same ID has conflicting source observations",
                      "answer": "Quarantine conflict",
                      "why": "Conflicting observations need investigation; do not silently choose one."
                    }
                  ],
                  "options": [
                    "Keep separate sample",
                    "Quarantine conflict",
                    "Remove proven duplicate"
                  ],
                  "success": "Quality log: remove the proven repeated S1 record; retain the separate S8 sample; quarantine conflicting S9 evidence for investigation."
