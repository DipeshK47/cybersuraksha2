            {
              "line": 132,
              "kind": "Exact text",
              "text": "Only the supplierâ€™s authorised programme task"
            },
            {
              "line": 132,
              "kind": "Exact text",
              "text": "A verified identity does not grant every permission. Limit access to the supplierâ€™s actual authorised purpose."
            },
            {
              "line": 133,
              "kind": "Exact text",
              "text": "Kabir places the portal controls"
            },
            {
              "line": 133,
              "kind": "Exact text",
              "text": "Browser claims are untrusted input"
            },
            {
              "line": 133,
              "kind": "Exact text",
              "text": "Enforce session and record permission on the server"
