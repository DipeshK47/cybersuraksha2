          "scenes": [
            {
              "id": "recover-and-learn-1",
              "label": "Meet the team",
              "title": "Recovery needs evidence",
              "mood": "happy",
              "caption": "Asha chooses between two fictional portal snapshots after an incident at fourteen ten. The exercise target is service restoration within thirty minutes and at most ten minutes of data loss. These are supplied planning objectives, not universal deadlines.",
              "dialogue": "Which restoration point is clean and complete?",
              "status": "Inspect the system",
              "tone": "normal",
              "start": 0,
              "duration": 16.064,
              "html": "<link rel=\"preload\" as=\"image\" href=\"/cyber-missions/class-12/incident-recovery-room.webp\"/><div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg><strong>Cyberpur Â· Class 12 portal design room</strong></div><h2 style=\"margin-top:18px\">Recovery needs evidence</h2><figure class=\"sceneIllustration\"><img src=\"/cyber-missions/class-12/incident-recovery-room.webp\" alt=\"Kabir orders synthetic event cards while Asha and a teacher compare dataset versions and a recovery checklist during a calm incident rehearsal.\" width=\"1400\" height=\"788\" decoding=\"async\"/><figcaption>Preserve the evidence, test restored records and permissions, and state what remains uncertain.</figcaption></figure><small class=\"note\">Synthetic records and offline models. No live scanning, exploitation, external messages or service changes.</small></div>"
            },
            {
              "id": "recover-and-learn-2",
              "label": "The problem",
              "title": "A recent copy can still be wrong",
              "mood": "surprise",
              "caption": "The fourteen eight snapshot is recent but contains an unauthorised guest permission and a missing registration. The fourteen hundred snapshot has the four expected records and the approved access model. Recent alone does not mean clean or complete.",
              "dialogue": "Check content and access, not only the timestamp.",
              "status": "Risk unresolved",
              "tone": "trouble",
              "start": 16.714,
              "duration": 16.235,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg><strong>Cyberpur Â· Class 12 portal design room</strong></div><h2 style=\"margin-top:18px\">A recent copy can still be wrong</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg><strong>Recovery exercise evidence Â· simulation</strong></div><div class=\"artifactRow\"><span>Incident / restore</span><strong>14:10 / 14:22</strong></div><div class=\"artifactRow\"><span>Exercise targets</span><strong>Downtime â‰¤30 min; data loss â‰¤10 min</strong></div><div class=\"artifactRow\"><span>14:08 copy</span><strong>Missing R40; guest can read private records</strong></div><div class=\"artifactRow\"><span>14:00 copy</span><strong>R10â€“R40 and correct access model</strong></div><div class=\"artifactRow\"><span>Checks</span><strong>Exact IDs/statuses; access; recovery time; recovery point</strong></div></div><small class=\"note\">Synthetic records and offline models. No live scanning, exploitation, external messages or service changes.</small></div>"
            },
            {
              "id": "recover-and-learn-3",
              "label": "How it works",
              "title": "Restore then verify",
              "mood": "thinking",
              "caption": "Use the clean point and test the exact expected IDs and statuses, intended organiser access and guest denial. Compare the actual restore time with the stated objective. Reopening requires evidence of service behaviour, not simply a completed copy operation.",
              "dialogue": "A recovery test must include the protections too.",
              "status": "Build the control",
              "tone": "normal",
              "start": 33.599,
              "duration": 17.472,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg><strong>Cyberpur Â· Class 12 portal design room</strong></div><h2 style=\"margin-top:18px\">Restore then verify</h2><div class=\"storyFacts\"><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Supplied time objective: 30 minutes</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Supplied data-loss objective: at most 10 minutes</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Test exact data and access before reopening</span></div></div><small class=\"note\">Synthetic records and offline models. No live scanning, exploitation, external messages or service changes.</small></div>"
            },
            {
              "id": "recover-and-learn-4",
              "label": "Your decision",
              "title": "Choose the recovery claim",
              "mood": "thinking",
              "caption": "A backup copies successfully, but nobody checks record completeness or access. Is that enough to declare recovery? Choose the requirement that makes the claim testable.",
              "dialogue": "Copy success is not service recovery evidence.",
              "status": "Decision required",
              "tone": "trouble",
              "start": 51.721,
              "duration": 10.901,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg><strong>Cyberpur Â· Class 12 portal design room</strong></div><h2 style=\"margin-top:18px\">Choose the recovery claim</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg><strong>Recovery exercise evidence Â· simulation</strong></div><div class=\"artifactRow\"><span>Incident / restore</span><strong>14:10 / 14:22</strong></div><div class=\"artifactRow\"><span>Exercise targets</span><strong>Downtime â‰¤30 min; data loss â‰¤10 min</strong></div><div class=\"artifactRow\"><span>14:08 copy</span><strong>Missing R40; guest can read private records</strong></div><div class=\"artifactRow\"><span>14:00 copy</span><strong>R10â€“R40 and correct access model</strong></div><div class=\"artifactRow\"><span>Checks</span><strong>Exact IDs/statuses; access; recovery time; recovery point</strong></div></div><div class=\"board\"><p class=\"storyQuestion\"><strong>A copy succeeds, but data completeness and access are untested. Can recovery be declared?</strong></p><div class=\"actionBank\"><button class=\"primary\" type=\"button\" aria-pressed=\"false\">Yes, the copy finished</button><button class=\"primary\" type=\"button\" aria-pressed=\"false\">Yes, if the snapshot is the newest</button><button class=\"primary\" type=\"button\" aria-pressed=\"false\">No; test completeness, access and the stated recovery objectives</button></div><button class=\"primary\" disabled=\"\" type=\"button\">Test my decision</button></div><small class=\"note\">Synthetic records and offline models. No live scanning, exploitation, external messages or service changes.</small></div>"
            },
            {
              "id": "recover-and-learn-5",
              "label": "What changes",
              "title": "A bounded recovery result",
              "mood": "happy",
              "caption": "The clean model is restored at fourteen twenty two. That is twelve minutes of downtime. The backup precedes the incident by ten minutes, so both exercise objectives are met. Access and data tests pass, but the team still documents limits and a follow-up improvement.",
              "dialogue": "State which tests passed and what they do not prove.",
              "status": "Evidence updated",
              "tone": "resolved",
              "start": 63.272,
              "duration": 16.576,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg><strong>Cyberpur Â· Class 12 portal design room</strong></div><h2 style=\"margin-top:18px\">A bounded recovery result</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg><strong>Recovery exercise evidence Â· simulation</strong></div><div class=\"artifactRow\"><span>Incident / restore</span><strong>14:10 / 14:22</strong></div><div class=\"artifactRow\"><span>Exercise targets</span><strong>Downtime â‰¤30 min; data loss â‰¤10 min</strong></div><div class=\"artifactRow\"><span>14:08 copy</span><strong>Missing R40; guest can read private records</strong></div><div class=\"artifactRow\"><span>14:00 copy</span><strong>R10â€“R40 and correct access model</strong></div><div class=\"artifactRow\"><span>Checks</span><strong>Exact IDs/statuses; access; recovery time; recovery point</strong></div></div><small class=\"note\">Synthetic records and offline models. No live scanning, exploitation, external messages or service changes.</small></div>"
            },
            {
              "id": "recover-and-learn-6",
              "label": "Enter the lab",
              "title": "Enter the recovery lab",
              "mood": "happy",
              "caption": "Interpret the two objectives, restore the harmless dataset model and test completeness, permissions and timing. Add an improvement action and keep an independent recovery route for the next supplier outage.",
              "dialogue": "Declare the tested result, not a guarantee.",
              "status": "Ready for practice",
              "tone": "resolved",
              "start": 80.498,
              "duration": 13.056,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg><strong>Cyberpur Â· Class 12 portal design room</strong></div><h2 style=\"margin-top:18px\">Enter the recovery lab</h2><div class=\"storyFacts\"><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Supplied time objective: 30 minutes</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Supplied data-loss objective: at most 10 minutes</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Test exact data and access before reopening</span></div></div><small class=\"note\">Synthetic records and offline models. No live scanning, exploitation, external messages or service changes.</small></div>"
            }
          ],
          "practice": [
            {
              "stage": 0,
              "brief": "Incident 14:10; exercise targets: restore within 30 minutes and lose at most 10 minutes of data. Restore a harmless in-page dataset, test exact IDs/statuses and permissions, then record a limited recovery conclusion.",
              "eyebrow": "Portal design and incident lab",
              "prompt": "Interpret the recovery objectives and evidence requirement.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><label class=\"matchRow\"><span>Restore service within 30 minutes of the incident</span><select aria-label=\"Restore service within 30 minutes of the incident\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Recovery time objective</option><option>Recovery point objective</option><option>Insufficient recovery evidence</option></select></label><label class=\"matchRow\"><span>Lose at most 10 minutes of data relative to the incident</span><select aria-label=\"Lose at most 10 minutes of data relative to the incident\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Recovery time objective</option><option>Recovery point objective</option><option>Insufficient recovery evidence</option></select></label><label class=\"matchRow\"><span>Copy completes without any access or data tests</span><select aria-label=\"Copy completes without any access or data tests\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Recovery time objective</option><option>Recovery point objective</option><option>Insufficient recovery evidence</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your system assurance record</h2><ol></ol><p>Use this checked evidence alongside the earlier portal, timeline and recovery chapter records for your individual explanation. Your teacher reviews the viva separately. All tests use fictional offline models.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
                  "rows": [
                    {
                      "label": "Restore service within 30 minutes of the incident",
                      "answer": "Recovery time objective",
                      "why": "This sets the exercise target for service downtime, not a legal deadline."
                    },
                    {
                      "label": "Lose at most 10 minutes of data relative to the incident",
                      "answer": "Recovery point objective",
                      "why": "This sets the exercise target for how far back the restored data may be."
                    },
                    {
                      "label": "Copy completes without any access or data tests",
                      "answer": "Insufficient recovery evidence",
                      "why": "A successful copy does not establish completeness or correct access."
                    }
                  ],
                  "options": [
                    "Recovery time objective",
                    "Recovery point objective",
                    "Insufficient recovery evidence"
                  ],
                  "success": "Recovery objectives: time objective limits exercise downtime to 30 minutes; point objective limits data-loss window to 10 minutes. Copy completion alone is insufficient; test exact data and intended access before reopening. These are supplied planning targets, not universal deadlines."
                }
              ]
            },
            {
              "stage": 1,
              "brief": "Incident 14:10; exercise targets: restore within 30 minutes and lose at most 10 minutes of data. Restore a harmless in-page dataset, test exact IDs/statuses and permissions, then record a limited recovery conclusion.",
              "eyebrow": "Portal design and incident lab",
              "prompt": "Choose a clean snapshot, restore the model and run four checks.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-network\" aria-hidden=\"true\"><rect x=\"16\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"2\" y=\"16\" width=\"6\" height=\"6\" rx=\"1\"></rect><rect x=\"9\" y=\"2\" width=\"6\" height=\"6\" rx=\"1\"></rect><path d=\"M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3\"></path><path d=\"M12 12V8\"></path></svg><strong>Recovery exercise evidence Â· simulation</strong></div><div class=\"artifactRow\"><span>Incident / restore</span><strong>14:10 / 14:22</strong></div><div class=\"artifactRow\"><span>Exercise targets</span><strong>Downtime â‰¤30 min; data loss â‰¤10 min</strong></div><div class=\"artifactRow\"><span>14:08 copy</span><strong>Missing R40; guest can read private records</strong></div><div class=\"artifactRow\"><span>14:00 copy</span><strong>R10â€“R40 and correct access model</strong></div><div class=\"artifactRow\"><span>Checks</span><strong>Exact IDs/statuses; access; recovery time; recovery point</strong></div></div><label class=\"matchRow\"><span>Snapshot to restore in the offline model</span><select><option value=\"recent-unsafe\" selected=\"\">14:08 Â· most recent, incomplete, unsafe guest access</option><option value=\"clean-1400\">14:00 Â· four expected records, approved permissions</option></select></label><button class=\"secondary\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-play\" aria-hidden=\"true\"><polygon points=\"6 3 20 12 6 21 6 3\"></polygon></svg>Restore model and verify</button><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Save recovery test</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your system assurance record</h2><ol></ol><p>Use this checked evidence alongside the earlier portal, timeline and recovery chapter records for your individual explanation. Your teacher reviews the viva separately. All tests use fictional offline models.</p></div>",
              "interactions": []
            },
            {
              "stage": 2,
              "brief": "Incident 14:10; exercise targets: restore within 30 minutes and lose at most 10 minutes of data. Restore a harmless in-page dataset, test exact IDs/statuses and permissions, then record a limited recovery conclusion.",
              "eyebrow": "Portal design and incident lab",
              "prompt": "Choose an improvement that addresses the recovery dependency.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><div class=\"actionBank\"><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Keep the only recovery key with the supplier that just failed</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Keep an independently available recovery method, schedule a restoration/access test and assign an owner to review the result</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Skip access tests next time because the copy command worked</button></div><button type=\"button\" class=\"primary\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check decision</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your system assurance record</h2><ol></ol><p>Use this checked evidence alongside the earlier portal, timeline and recovery chapter records for your individual explanation. Your teacher reviews the viva separately. All tests use fictional offline models.</p></div>",
              "interactions": [
                {
                  "type": "ChoiceTask",
                  "choices": [
                    "Keep the only recovery key with the supplier that just failed",
                    "Keep an independently available recovery method, schedule a restoration/access test and assign an owner to review the result",
                    "Skip access tests next time because the copy command worked"
                  ],
                  "answer": 1,
                  "feedback": "Recovery depends on accessible private recovery methods and repeated data/access tests with a responsible owner. Copy success or supplier dependence leaves the same weakness in place.",
                  "success": "Improvement: retain an independent private recovery route; schedule a harmless restoration test covering exact data and permissions; assign the operations lead a review date and follow up failures. A successful small exercise cannot guarantee every real incident outcome."
                }
              ]
            }
          ],
          "decisionTask": {
            "title": "Asha verifies recovery",
            "concepts": [
              "Supplied time objective: 30 minutes",
              "Supplied data-loss objective: at most 10 minutes",
              "Test exact data and access before reopening"
            ],
            "question": "A copy succeeds, but data completeness and access are untested. Can recovery be declared?",
            "choices": [
              "Yes, the copy finished",
              "Yes, if the snapshot is the newest",
              "No; test completeness, access and the stated recovery objectives"
            ],
            "answer": 2,
            "why": "Copy completion alone does not establish service behaviour, clean permissions or the exercise recovery targets."
          }
