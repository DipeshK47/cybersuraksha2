          "practice": [
            {
              "stage": 0,
              "brief": "Synthetic enquiry families may contain duplicates, paraphrases or related views. Keep a family together. Training fits parameters; validation guides choices; final test evaluates a frozen candidate without answer-informed tuning.",
              "eyebrow": "AI evidence and assurance lab",
              "prompt": "Assign training, validation and final-test roles.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><label class=\"matchRow\"><span>Fit model parameters using examples</span><select aria-label=\"Fit model parameters using examples\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Training</option><option>Validation</option><option>Final test</option></select></label><label class=\"matchRow\"><span>Choose settings or operating point before final evaluation</span><select aria-label=\"Choose settings or operating point before final evaluation\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Training</option><option>Validation</option><option>Final test</option></select></label><label class=\"matchRow\"><span>Evaluate the frozen candidate on independent cases</span><select aria-label=\"Evaluate the frozen candidate on independent cases\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Training</option><option>Validation</option><option>Final test</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your AI assurance record</h2><ol></ol><p>Use this checked record with the moduleâ€™s baseline, manifest, calculations and model card for your teacherâ€™s individual review. Automatic checks assess structured decisions, not authorship or the oral defence. All results are prepared classroom evidence.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
                  "rows": [
                    {
                      "label": "Fit model parameters using examples",
