          "practice": [
            {
              "stage": 0,
              "brief": "Choose rules, learned predictions or generated drafts from the task. Exact arithmetic and verified lookups can be sufficient. Generated language still needs evidence.",
              "eyebrow": "Festival AI evaluation lab",
              "prompt": "Choose an approach for three festival tasks.",
              "html": "<section><div class=\"lab illustratedActivity\"><figure class=\"sceneIllustration\"><img src=\"/cyber-missions/class-11/festival-planning.webp\" alt=\"Two students plan a school festival using a laptop, notebooks and project folders.\" width=\"1400\" height=\"788\" decoding=\"async\" loading=\"lazy\"/><figcaption>Start with the task, the people using it and a testable definition of success.</figcaption></figure><div class=\"senior\"><div class=\"board\"><label class=\"matchRow\"><span>Calculate an exact ticket bill from fixed prices</span><select aria-label=\"Calculate an exact ticket bill from fixed prices\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Explicit rule</option><option>Learned prediction</option><option>Generated response</option></select></label><label class=\"matchRow\"><span>Suggest a material category from a sample image</span><select aria-label=\"Suggest a material category from a sample image\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Explicit rule</option><option>Learned prediction</option><option>Generated response</option></select></label><label class=\"matchRow\"><span>Draft a friendly volunteer message for a person to check</span><select aria-label=\"Draft a friendly volunteer message for a person to check\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Explicit rule</option><option>Learned prediction</option><option>Generated response</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your AI evaluation record</h2><ol></ol><p>Use this evidence for your teacherâ€™s individual review. The automatic checks assess structured decisions, not the quality of an oral defence.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
