          "practice": [
            {
              "stage": 0,
              "brief": "For real Indian financial cyber fraud, immediately contact bank/payment provider using a trusted channel and promptly report via 1930 or cybercrime.gov.in, with trusted-adult support. Do not delay contact to collect a perfect file. This exercise never submits a report.",
              "eyebrow": "Evidence and verification lab",
              "prompt": "Choose prompt contacts and supportive actions.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><div class=\"board\"><label class=\"checkRow\"><input type=\"checkbox\"/><span>Immediately contact bank/payment provider through a trusted channel</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>Promptly report Indian financial cyber fraud via 1930 or cybercrime.gov.in</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>Involve a trusted adult and preserve available evidence without delaying contact</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>Pay a recovery agent before contacting the bank</span></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>Test protection</button></div><p class=\"micro\">Official guidance: <a href=\"https://navimumbaipolice.gov.in/en/citizen/cyber-security\" target=\"_blank\" rel=\"noreferrer\">bank contact, evidence and reporting</a> Â· <a href=\"https://cybercrime.gov.in/\" target=\"_blank\" rel=\"noreferrer\">National Cyber Crime Reporting Portal</a>. These resources are for real incidents; this lesson makes no call or submission.</p></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your verification evidence record</h2><ol></ol><p>Structured decisions are checked automatically. Your teacher reviews the actual portfolio, individual defence and reflection. All case records are fictional.</p></div>",
              "interactions": [
                {
                  "type": "ControlChecklist",
                  "controls": [
                    {
                      "id": "bank",
                      "label": "Immediately contact bank/payment provider through a trusted channel",
                      "good": true,
                      "why": "Prompt contact can help limit further harm; do not wait for a complete file."
                    },
                    {
                      "id": "report",
                      "label": "Promptly report Indian financial cyber fraud via 1930 or cybercrime.gov.in",
                      "good": true,
                      "why": "Use official reporting routes while seeking help, not a senderâ€™s recovery link."
                    },
                    {
                      "id": "support",
                      "label": "Involve a trusted adult and preserve available evidence without delaying contact",
                      "good": true,
                      "why": "Support and evidence gathering can happen alongside urgent contact."
                    },
                    {
                      "id": "recovery",
                      "label": "Pay a recovery agent before contacting the bank",
                      "good": false,
                      "why": "A recovery fee or guarantee can be another fraud. Reporting does not guarantee recovery."
                    }
                  ],
                  "success": "Response plan: immediately contact bank/payment provider through a trusted channel; promptly use 1930 or cybercrime.gov.in for Indian financial cyber fraud; involve a trusted adult and preserve available evidence without delaying contact. Do not pay recovery agents or blame the person targeted."
                }
              ]
            },
            {
              "stage": 1,
