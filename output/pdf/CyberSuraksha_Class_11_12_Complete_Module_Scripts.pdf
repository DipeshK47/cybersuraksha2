          "decisionTask": {
            "title": "Asha trims the registration form",
            "icon": {},
            "panels": [
              {
                "heading": "A form for programme updates",
                "facts": [
                  "Purpose: send updates through school email",
                  "Requested: school email, home address, ID scan, bank details",
                  "Every extra field creates another record to protect"
                ]
              },
              {
                "heading": "More data is not automatically better",
                "facts": [
                  "Home address is unrelated to email updates",
                  "ID scans are unnecessary for the stated purpose",
                  "Bank details are unnecessary when no payment is involved"
                ]
              },
              {
                "heading": "Follow data through its lifecycle",
                "facts": [
                  "Collect only what the purpose requires",
                  "Store it with restricted access",
                  "Set a justified retention plan",
                  "Delete or anonymise when the purpose ends, subject to authorised holds"
                ]
              },
              {
                "heading": "Keep only a necessary field",
                "facts": [
                  "The team only sends programme updates",
                  "The contact channel is school email",
                  "No delivery, identity check or payment is part of this form"
                ]
              },
              {
                "heading": "The smaller form still works",
                "facts": [
                  "School email: collected for updates",
                  "Home address, ID and bank fields: removed",
                  "Registration team access: restricted"
                ]
              },
              {
                "heading": "The festival ends. Data needs a decision.",
                "facts": [
                  "Completed follow-up: apply the stated deletion plan",
                  "Planning: prefer anonymous totals",
                  "Active complaint: restrict relevant records for authorised review",
                  "Next: build, restrict and retire a fictional dataset"
                ]
              }
            ],
