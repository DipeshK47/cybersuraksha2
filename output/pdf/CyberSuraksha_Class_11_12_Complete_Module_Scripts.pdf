          "scenes": [
            {
              "id": "how-a-scam-builds-pressure-1",
              "label": "Meet the team",
              "title": "The offer arrives",
              "mood": "happy",
              "caption": "Asha receives a fictional college-preparation offer. The message promises a reward, claims official authority and demands a decision before the next bell. Instead of reacting immediately, she asks what the sender wants her to do.",
              "dialogue": "What action is the message pushing?",
              "status": "Inspect the case",
              "tone": "normal",
              "start": 0,
              "duration": 14.997,
              "html": "<link rel=\"preload\" as=\"image\" href=\"/cyber-missions/class-11/fraud-offer-desk.webp\"/><div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><strong>Cyberpur Â· Class 11 verification desk</strong></div><h2 style=\"margin-top:18px\">The offer arrives</h2><figure class=\"sceneIllustration\"><img src=\"/cyber-missions/class-11/fraud-offer-desk.webp\" alt=\"Asha pauses before handing over an identity envelope while Kabir compares an internship offer with an independent source and a teacher helps nearby.\" width=\"1400\" height=\"788\" decoding=\"async\"/><figcaption>Compare the exact offer with an independent source before sharing documents or money.</figcaption></figure><small class=\"note\">Fictional cases only. No real payments, calls, document uploads or reports.</small></div>"
            },
            {
              "id": "how-a-scam-builds-pressure-2",
              "label": "The problem",
              "title": "Five pressure levers",
              "mood": "surprise",
              "caption": "The offer says there are only two places, that an admissions officer has selected Asha, and that she must keep the opportunity secret. Urgency, scarcity, authority, secrecy and reward can work together to crowd out a careful check.",
              "dialogue": "Pressure is evidence to inspect, not proof by itself.",
              "status": "Evidence unresolved",
              "tone": "trouble",
              "start": 15.647,
              "duration": 14.827,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><strong>Cyberpur Â· Class 11 verification desk</strong></div><h2 style=\"margin-top:18px\">Five pressure levers</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><strong>College-place offer Â· simulation</strong></div><div class=\"artifactRow\"><span>Deadline</span><strong>Five minutes</strong></div><div class=\"artifactRow\"><span>Claimed authority</span><strong>Admissions director</strong></div><div class=\"artifactRow\"><span>Availability / reward</span><strong>Two places Â· guaranteed stipend</strong></div><div class=\"artifactRow\"><span>Instruction</span><strong>Keep secret and pay now</strong></div><div class=\"artifactRow\"><span>Evidence status</span><strong>Unverified sender and claim</strong></div></div><small class=\"note\">Fictional cases only. No real payments, calls, document uploads or reports.</small></div>"
            },
            {
              "id": "how-a-scam-builds-pressure-3",
              "label": "How it works",
              "title": "Separate signals from proof",
              "mood": "thinking",
              "caption": "A short deadline can occur in a genuine message too. A warning sign is a reason to pause and verify the claim independently. Do not decide from one phrase, a logo or an emotional reaction alone.",
              "dialogue": "Which independent source could check the claim?",
              "status": "Build a check",
              "tone": "normal",
              "start": 31.124,
              "duration": 14.272,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><strong>Cyberpur Â· Class 11 verification desk</strong></div><h2 style=\"margin-top:18px\">Separate signals from proof</h2><div class=\"storyFacts\"><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Urgency, authority, scarcity, secrecy, reward</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>A warning sign is not proof by itself</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Pause and verify through a separate trusted route</span></div></div><small class=\"note\">Fictional cases only. No real payments, calls, document uploads or reports.</small></div>"
            },
            {
              "id": "how-a-scam-builds-pressure-4",
              "label": "Your decision",
              "title": "Choose the next move",
              "mood": "thinking",
              "caption": "The sender says a small payment will secure the place if Asha acts now. Should she pay, accuse someone publicly, or pause and check through an independently located college contact? Choose a response supported by the evidence.",
              "dialogue": "Protect the decision before the deadline takes over.",
              "status": "Decision required",
              "tone": "trouble",
              "start": 46.046,
              "duration": 14.293,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><strong>Cyberpur Â· Class 11 verification desk</strong></div><h2 style=\"margin-top:18px\">Choose the next move</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><strong>College-place offer Â· simulation</strong></div><div class=\"artifactRow\"><span>Deadline</span><strong>Five minutes</strong></div><div class=\"artifactRow\"><span>Claimed authority</span><strong>Admissions director</strong></div><div class=\"artifactRow\"><span>Availability / reward</span><strong>Two places Â· guaranteed stipend</strong></div><div class=\"artifactRow\"><span>Instruction</span><strong>Keep secret and pay now</strong></div><div class=\"artifactRow\"><span>Evidence status</span><strong>Unverified sender and claim</strong></div></div><div class=\"board\"><p class=\"storyQuestion\"><strong>The offer asks for a payment in five minutes. What is a supported next step?</strong></p><div class=\"actionBank\"><button class=\"primary\" type=\"button\" aria-pressed=\"false\">Pay now to avoid missing out</button><button class=\"primary\" type=\"button\" aria-pressed=\"false\">Pause and check through an independently located college contact</button><button class=\"primary\" type=\"button\" aria-pressed=\"false\">Publicly accuse the named organisation without checking</button></div><button class=\"primary\" disabled=\"\" type=\"button\">Test my decision</button></div><small class=\"note\">Fictional cases only. No real payments, calls, document uploads or reports.</small></div>"
            },
            {
              "id": "how-a-scam-builds-pressure-5",
              "label": "What changes",
              "title": "A calmer verification",
              "mood": "happy",
              "caption": "Asha keeps the message and finds the organisation through a separate trusted route. She does not use the contact supplied by the offer. The claim stays unverified until independent evidence supports it.",
              "dialogue": "We can pause without pretending we know everything.",
              "status": "Evidence updated",
              "tone": "resolved",
              "start": 60.989,
              "duration": 13.461,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><strong>Cyberpur Â· Class 11 verification desk</strong></div><h2 style=\"margin-top:18px\">A calmer verification</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><strong>College-place offer Â· simulation</strong></div><div class=\"artifactRow\"><span>Deadline</span><strong>Five minutes</strong></div><div class=\"artifactRow\"><span>Claimed authority</span><strong>Admissions director</strong></div><div class=\"artifactRow\"><span>Availability / reward</span><strong>Two places Â· guaranteed stipend</strong></div><div class=\"artifactRow\"><span>Instruction</span><strong>Keep secret and pay now</strong></div><div class=\"artifactRow\"><span>Evidence status</span><strong>Pause; independent college check required</strong></div></div><small class=\"note\">Fictional cases only. No real payments, calls, document uploads or reports.</small></div>"
            },
            {
              "id": "how-a-scam-builds-pressure-6",
              "label": "Enter the lab",
              "title": "Enter the verification lab",
              "mood": "happy",
              "caption": "Map the pressure tactics, distinguish a warning sign from proof and transfer the same reasoning to a new message. Your record will pair each concern with a specific safe verification action.",
              "dialogue": "A useful warning leads to a useful check.",
              "status": "Ready for practice",
              "tone": "resolved",
              "start": 75.101,
              "duration": 12.203,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg><strong>Cyberpur Â· Class 11 verification desk</strong></div><h2 style=\"margin-top:18px\">Enter the verification lab</h2><div class=\"storyFacts\"><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Urgency, authority, scarcity, secrecy, reward</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>A warning sign is not proof by itself</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Pause and verify through a separate trusted route</span></div></div><small class=\"note\">Fictional cases only. No real payments, calls, document uploads or reports.</small></div>"
