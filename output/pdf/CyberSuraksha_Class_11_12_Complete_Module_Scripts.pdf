          "scenes": [
            {
              "id": "the-model-that-scores-95-percent-1",
              "label": "Meet the team",
              "title": "The ninety-five-percent claim",
              "mood": "happy",
              "caption": "Asha sees a prepared classifier sheet reporting ninety five percent accuracy. In the supplied hundred requests, only five genuinely need staff review. The headline alone does not show whether the rare cases were found.",
              "dialogue": "What sits inside that percentage?",
              "status": "Inspect the evidence",
              "tone": "normal",
              "start": 0,
              "duration": 14.997,
              "html": "<link rel=\"preload\" as=\"image\" href=\"/cyber-missions/class-12/ai-evaluation-workshop.webp\"/><div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-check\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"m9 14 2 2 4-4\"></path></svg><strong>Cyberpur Â· Class 12 AI assurance desk</strong></div><h2 style=\"margin-top:18px\">The ninety-five-percent claim</h2><figure class=\"sceneIllustration\"><img src=\"/cyber-missions/class-12/ai-evaluation-workshop.webp\" alt=\"Asha and Kabir inspect a missed enquiry among anonymous cards while their teacher compares two prepared classifier-result sheets.\" width=\"1400\" height=\"788\" decoding=\"async\"/><figcaption>A high overall score can hide the few cases the decision most needs to catch. Compare errors with the stated goal.</figcaption></figure><small class=\"note\">Synthetic records and prepared results only. No live AI, private student data, paid API or external tool action.</small></div>"
            },
            {
              "id": "the-model-that-scores-95-percent-2",
              "label": "The problem",
              "title": "Read the confusion table",
              "mood": "surprise",
              "caption": "The stricter candidate finds one staff-review case, misses four, flags one routine case and correctly leaves ninety four routine cases unflagged. Its accuracy is ninety five percent, precision fifty percent and recall twenty percent.",
              "dialogue": "Four of the five important cases were missed.",
              "status": "Claim unresolved",
              "tone": "trouble",
              "start": 15.647,
              "duration": 15.253,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-check\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"m9 14 2 2 4-4\"></path></svg><strong>Cyberpur Â· Class 12 AI assurance desk</strong></div><h2 style=\"margin-top:18px\">Read the confusion table</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-check\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"m9 14 2 2 4-4\"></path></svg><strong>Prepared result sheet Â· classroom pack</strong></div><div class=\"artifactRow\"><span>Strict candidate</span><strong>TP1 Â· FP1 Â· FN4 Â· TN94</strong></div><div class=\"artifactRow\"><span>Accuracy</span><strong>95/100 = 95%</strong></div><div class=\"artifactRow\"><span>Precision</span><strong>1/(1+1) = 50%</strong></div><div class=\"artifactRow\"><span>Recall</span><strong>1/(1+4) = 20%</strong></div><div class=\"artifactRow\"><span>Limit</span><strong>Prepared development sheets; independent final evidence still required</strong></div></div><small class=\"note\">Synthetic records and prepared results only. No live AI, private student data, paid API or external tool action.</small></div>"
            },
            {
              "id": "the-model-that-scores-95-percent-3",
              "label": "How it works",
              "title": "Compare thresholds and costs",
              "mood": "thinking",
              "caption": "A second prepared operating point finds four cases but flags six routine requests. It uses ten review slots and meets the exercise recall target. With missed cases costing five and extra reviews costing one, its total error cost is lower on this pack.",
              "dialogue": "More accuracy is not automatically a better decision.",
              "status": "Build the check",
              "tone": "normal",
              "start": 31.551,
              "duration": 16.939,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-check\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"m9 14 2 2 4-4\"></path></svg><strong>Cyberpur Â· Class 12 AI assurance desk</strong></div><h2 style=\"margin-top:18px\">Compare thresholds and costs</h2><div class=\"storyFacts\"><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Strict sheet: TP1, FP1, FN4, TN94</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Precision 1/2=50%; recall 1/5=20%</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Choose for the preset costs and review capacity</span></div></div><small class=\"note\">Synthetic records and prepared results only. No live AI, private student data, paid API or external tool action.</small></div>"
            },
            {
              "id": "the-model-that-scores-95-percent-4",
              "label": "Your decision",
              "title": "Choose for the stated goal",
              "mood": "thinking",
              "caption": "Should Asha accept ninety five percent without checking misses, choose the candidate that meets the preset recall and capacity criteria, or hide false positives to make the report cleaner?",
              "dialogue": "Use the acceptance plan, not the biggest headline.",
              "status": "Decision required",
              "tone": "trouble",
              "start": 49.139,
              "duration": 12.117,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-check\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"m9 14 2 2 4-4\"></path></svg><strong>Cyberpur Â· Class 12 AI assurance desk</strong></div><h2 style=\"margin-top:18px\">Choose for the stated goal</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-check\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"m9 14 2 2 4-4\"></path></svg><strong>Prepared result sheet Â· classroom pack</strong></div><div class=\"artifactRow\"><span>Strict candidate</span><strong>TP1 Â· FP1 Â· FN4 Â· TN94</strong></div><div class=\"artifactRow\"><span>Accuracy</span><strong>95/100 = 95%</strong></div><div class=\"artifactRow\"><span>Precision</span><strong>1/(1+1) = 50%</strong></div><div class=\"artifactRow\"><span>Recall</span><strong>1/(1+4) = 20%</strong></div><div class=\"artifactRow\"><span>Limit</span><strong>Prepared development sheets; independent final evidence still required</strong></div></div><div class=\"board\"><p class=\"storyQuestion\"><strong>Which choice follows the stated exercise goal?</strong></p><div class=\"actionBank\"><button class=\"primary\" type=\"button\" aria-pressed=\"false\">Use the operating point meeting the preset recall, cost and capacity criteria</button><button class=\"primary\" type=\"button\" aria-pressed=\"false\">Accept 95% without inspecting misses</button><button class=\"primary\" type=\"button\" aria-pressed=\"false\">Hide extra-review errors</button></div><button class=\"primary\" disabled=\"\" type=\"button\">Test my decision</button></div><small class=\"note\">Synthetic records and prepared results only. No live AI, private student data, paid API or external tool action.</small></div>"
            },
            {
              "id": "the-model-that-scores-95-percent-5",
              "label": "What changes",
              "title": "A conditional threshold choice",
              "mood": "happy",
              "caption": "The review-more operating point fits the supplied low-stakes costs and capacity. Its precision is still limited and its evidence is only this prepared pack. If error costs or review capacity change, the preferred comparator can change too.",
              "dialogue": "State both the choice and its conditions.",
              "status": "Evidence updated",
              "tone": "resolved",
              "start": 61.907,
              "duration": 15.467,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-check\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"m9 14 2 2 4-4\"></path></svg><strong>Cyberpur Â· Class 12 AI assurance desk</strong></div><h2 style=\"margin-top:18px\">A conditional threshold choice</h2><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-check\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"m9 14 2 2 4-4\"></path></svg><strong>Prepared result sheet Â· classroom pack</strong></div><div class=\"artifactRow\"><span>Strict candidate</span><strong>TP1 Â· FP1 Â· FN4 Â· TN94</strong></div><div class=\"artifactRow\"><span>Accuracy</span><strong>95/100 = 95%</strong></div><div class=\"artifactRow\"><span>Precision</span><strong>1/(1+1) = 50%</strong></div><div class=\"artifactRow\"><span>Recall</span><strong>1/(1+4) = 20%</strong></div><div class=\"artifactRow\"><span>Limit</span><strong>Prepared development sheets; independent final evidence still required</strong></div></div><small class=\"note\">Synthetic records and prepared results only. No live AI, private student data, paid API or external tool action.</small></div>"
            },
            {
              "id": "the-model-that-scores-95-percent-6",
              "label": "Enter the lab",
              "title": "Enter the metrics lab",
              "mood": "happy",
              "caption": "Calculate precision and recall, compare prepared operating points and reconsider the choice under changed error costs. The scores are supplied classroom sheets, not measurements of a deployed AI system.",
