              "eyebrow": "Reliable automation lab",
              "prompt": "State stable-identity and human-policy limits.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><label class=\"matchRow\"><span>Two records have the same stable ID</span><select aria-label=\"Two records have the same stable ID\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Flag the conflict before unique-key lookup</option><option>Seek authorised policy review; FIFO alone cannot decide priority</option><option>Its stable identity should not depend on the old position</option></select></label><label class=\"matchRow\"><span>A new urgent-priority policy is proposed</span><select aria-label=\"A new urgent-priority policy is proposed\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Flag the conflict before unique-key lookup</option><option>Seek authorised policy review; FIFO alone cannot decide priority</option><option>Its stable identity should not depend on the old position</option></select></label><label class=\"matchRow\"><span>One item changes position in a list</span><select aria-label=\"One item changes position in a list\"><option value=\"\" selected=\"\">Chooseâ€¦</option><option>Flag the conflict before unique-key lookup</option><option>Seek authorised policy review; FIFO alone cannot decide priority</option><option>Its stable identity should not depend on the old position</option></select></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check my map</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your automation evidence record</h2><ol></ol><p>Use the checked records across the module for your teacherâ€™s individual review. Automatic checks assess structured decisions, not authorship or the oral defence. All traces are fictional offline models.</p></div>",
              "interactions": [
                {
                  "type": "MatchTable",
                  "rows": [
                    {
                      "label": "Two records have the same stable ID",
                      "answer": "Flag the conflict before unique-key lookup",
                      "why": "A convenient map must not silently overwrite unresolved records."
                    },
                    {
                      "label": "A new urgent-priority policy is proposed",
                      "answer": "Seek authorised policy review; FIFO alone cannot decide priority",
                      "why": "A data structure implements a rule but does not authorise a change."
                    },
                    {
                      "label": "One item changes position in a list",
                      "answer": "Its stable identity should not depend on the old position",
                      "why": "A position may change as other items are inserted or removed."
                    }
                  ],
                  "options": [
                    "Flag the conflict before unique-key lookup",
                    "Seek authorised policy review; FIFO alone cannot decide priority",
                    "Its stable identity should not depend on the old position"
                  ],
                  "success": "Model limits: hold duplicate IDs before unique lookup; seek authorised review for priority-policy changes; keep stable identity independent of a changing list position. Data structure choice does not resolve a personâ€™s identity or authorise a policy."
                }
              ]
            }
          ],
          "decisionTask": {
            "title": "Asha chooses the data model",
            "concepts": [
              "Ordered list and stable-key lookup serve different operations",
              "Stack: latest first; queue: earliest waiting first",
              "Duplicate identity and priority-policy changes need human review"
            ],
            "question": "Which model fits first-come support?",
            "choices": [
              "Newest ticket jumps ahead automatically",
              "Match identity by name alone",
              "Queue: serve the earliest waiting ticket first"
            ],
            "answer": 2,
            "why": "A queue implements first-in, first-out ordering. A priority exception is a separate authorised policy decision."
          }
        },
