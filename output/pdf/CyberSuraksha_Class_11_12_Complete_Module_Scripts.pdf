          "scenes": [
            {
              "id": "what-a-browser-can-tell-you-1",
              "label": "Meet the team",
              "title": "A familiar page",
              "mood": "happy",
              "caption": "Kabir receives a festival link. The page has a school crest and a familiar title, and it asks him to sign in. Those page details can be copied. He needs to inspect what the browser actually opened.",
              "dialogue": "The page looks familiar. What does the address say?",
              "status": "Planning the festival",
              "tone": "normal",
              "start": 0,
              "duration": 13.269,
              "html": "<link rel=\"preload\" as=\"image\" href=\"/cyber-missions/class-11/account-access.webp\"/><div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><strong>Cyberpur Â· Class 11 festival team</strong></div><h2 style=\"margin-top:18px\">A programme link arrives</h2><figure class=\"sceneIllustration\"><img src=\"/cyber-missions/class-11/account-access.webp\" alt=\"A student reviews people and folder permissions on a laptop beside a sign-in phone, a separate envelope and a locked drawer.\" width=\"1400\" height=\"788\" decoding=\"async\"/><figcaption>The team reviews who can sign in, what they can open and how access can be recovered privately.</figcaption></figure><small class=\"note\">Fictional records and accounts. No personal credentials are needed.</small></div>"
            },
            {
              "id": "what-a-browser-can-tell-you-2",
              "label": "The problem",
              "title": "Read the address",
              "mood": "surprise",
              "caption": "The hostname begins with the school name but continues into another domain. The known school hostname is different. A familiar word inside an address does not mean that the whole address belongs to that organisation.",
              "dialogue": "Read all the way to the next slash.",
              "status": "Investigating a problem",
              "tone": "trouble",
              "start": 13.919,
              "duration": 14.101,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><strong>Cyberpur Â· Class 11 festival team</strong></div><h2 style=\"margin-top:18px\">Read beyond the familiar words</h2><div class=\"browser\"><div class=\"address\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><code>https://cyberpurschool.example.verify-event.example/login</code></div><div class=\"webpage\"><span>Supplied link Â· unverified</span><h3>Cyberpur School Festival</h3><p>Sign in to confirm your place</p></div></div><div class=\"storyFacts\"><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-triangle-alert\" aria-hidden=\"true\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg><span>https://cyberpurschool.example.verify-event.example/login</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-triangle-alert\" aria-hidden=\"true\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg><span>Known school host: cyberpurschool.example</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-triangle-alert\" aria-hidden=\"true\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"></path><path d=\"M12 9v4\"></path><path d=\"M12 17h.01\"></path></svg><span>A familiar word can appear inside a different hostname</span></div></div><small class=\"note\">Fictional records and accounts. No personal credentials are needed.</small></div>"
            },
            {
              "id": "what-a-browser-can-tell-you-3",
              "label": "How it works",
              "title": "Connection limits",
              "mood": "thinking",
              "caption": "H T T P S protects the connection to the hostname shown. It does not establish that the operator is your school or that a request is honest. An independent known address or school contact helps verify the claim.",
              "dialogue": "A protected connection is not an endorsement.",
              "status": "Thinking it through",
              "tone": "normal",
              "start": 28.671,
              "duration": 14.912,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><strong>Cyberpur Â· Class 11 festival team</strong></div><h2 style=\"margin-top:18px\">A connection is not an endorsement</h2><div class=\"browser\"><div class=\"address\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><code>https://cyberpurschool.example.verify-event.example/login</code></div><div class=\"webpage\"><span>Supplied link Â· unverified</span><h3>Cyberpur School Festival</h3><p>Sign in to confirm your place</p></div></div><div class=\"storyFacts\"><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>HTTPS protects the connection to the shown hostname</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>The site operator can still be untrustworthy</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Verify through an independently known school route</span></div></div><small class=\"note\">Fictional records and accounts. No personal credentials are needed.</small></div>"
            },
            {
              "id": "what-a-browser-can-tell-you-4",
              "label": "Your decision",
              "title": "Your decision",
              "mood": "thinking",
              "caption": "Identify the full hostname in the supplied address bar. Start after the scheme and stop at the next slash. Do not use the page title, logo or only the familiar beginning.",
              "dialogue": "Which hostname did we really open?",
              "status": "Your turn",
              "tone": "normal",
              "start": 44.233,
              "duration": 11.968,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><strong>Cyberpur Â· Class 11 festival team</strong></div><h2 style=\"margin-top:18px\">Which address did the browser open?</h2><div class=\"browser\"><div class=\"address\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><code>https://cyberpurschool.example.verify-event.example/login</code></div><div class=\"webpage\"><span>Supplied link Â· unverified</span><h3>Cyberpur School Festival</h3><p>Sign in to confirm your place</p></div></div><div class=\"storyFacts\"><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Hostname comes after https:// and before the next slash</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Do not use the page heading as the address</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Compare the complete hostname</span></div></div><div class=\"board\"><p><strong>Which hostname is actually in the supplied address bar?</strong></p><div class=\"actionBank\"><button class=\"primary\" type=\"button\" aria-pressed=\"false\">cyberpurschool.example</button><button class=\"primary\" type=\"button\" aria-pressed=\"false\">cyberpurschool.example.verify-event.example</button><button class=\"primary\" type=\"button\" aria-pressed=\"false\">Cyberpur School Festival</button></div><button type=\"button\" class=\"primary\" disabled=\"\">Test my decision</button></div><small class=\"note\">Fictional records and accounts. No personal credentials are needed.</small></div>"
            },
            {
              "id": "what-a-browser-can-tell-you-5",
              "label": "What changes",
              "title": "Independent route",
              "mood": "happy",
              "caption": "Kabir uses the school address from his diary and checks through the school instead of replying to the suspicious sender. He does not type credentials into the supplied page. He records the evidence and its limits.",
              "dialogue": "I will use a route I already know.",
              "status": "Revising the plan",
              "tone": "resolved",
              "start": 56.851,
              "duration": 13.248,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><strong>Cyberpur Â· Class 11 festival team</strong></div><h2 style=\"margin-top:18px\">Kabir takes an independent route</h2><div class=\"browser\"><div class=\"address\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><code>https://cyberpurschool.example/events</code></div><div class=\"webpage\"><span>Address from school diary</span><h3>Cyberpur School Festival</h3><p>Programme Â· Friday Â· School hall</p></div></div><div class=\"storyFacts\"><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>He uses the address from the school diary</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>He checks with the school rather than replying to the sender</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>He does not enter credentials into the supplied page</span></div></div><small class=\"note\">Fictional records and accounts. No personal credentials are needed.</small></div>"
            },
            {
              "id": "what-a-browser-can-tell-you-6",
              "label": "Enter the lab",
              "title": "Enter the lab",
              "mood": "happy",
              "caption": "A programme page also asks for access to contacts. Displaying festival times does not need the whole contact list. In the lab, read full hostnames, explain connection indicators and make a proportionate permission decision.",
              "dialogue": "Check both the destination and the request.",
              "status": "Ready to practise",
              "tone": "resolved",
              "start": 70.749,
              "duration": 15.019,
              "html": "<div class=\"storyBoard\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><strong>Cyberpur Â· Class 11 festival team</strong></div><h2 style=\"margin-top:18px\">Check permissions too</h2><div class=\"browser\"><div class=\"address\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-globe\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20\"></path><path d=\"M2 12h20\"></path></svg><code>https://cyberpurschool.example/events</code></div><div class=\"webpage\"><span>Address from school diary</span><h3>Cyberpur School Festival</h3><p>Programme Â· Friday Â· School hall</p></div></div><div class=\"storyFacts\"><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>A programme page does not need the contact list</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Connection clues have limits</span></div><div class=\"storyFact\" data-active=\"true\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg><span>Next: inspect three fictional browser cases</span></div></div><small class=\"note\">Fictional records and accounts. No personal credentials are needed.</small></div>"
            }
