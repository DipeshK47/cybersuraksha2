          "practice": [
            {
              "stage": 0,
              "brief": "Assemble the baseline, split audit, counts/costs, shift observations, source/trust checks and model card. A go/revise/stop recommendation needs an authorised human owner and conditions that could change the decision.",
              "eyebrow": "AI evidence and assurance lab",
              "prompt": "Select the evidence that belongs in the assurance pack.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><label class=\"checkRow\"><input type=\"checkbox\"/><span>Task, baseline, costs and acceptance criteria set before the reveal</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>Leakage audit and frozen split manifest</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>Confusion counts, threshold tradeoff, group counts and shift limitations</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>Source/trust checks, model card, human override and stop-use owner</span></label><label class=\"checkRow\"><input type=\"checkbox\"/><span>Hide the weak group and report only the 95% headline</span></label><button class=\"primary\" disabled=\"\" type=\"button\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg>Test protection</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your AI assurance record</h2><ol></ol><p>Use this checked record with the moduleâ€™s baseline, manifest, calculations and model card for your teacherâ€™s individual review. Automatic checks assess structured decisions, not authorship or the oral defence. All results are prepared classroom evidence.</p></div>",
              "interactions": [
                {
                  "type": "ControlChecklist",
                  "controls": [
                    {
                      "id": "baseline",
                      "label": "Task, baseline, costs and acceptance criteria set before the reveal",
                      "good": true,
                      "why": "A metric should answer a pre-specified decision question."
                    },
                    {
                      "id": "split",
                      "label": "Leakage audit and frozen split manifest",
                      "good": true,
                      "why": "Related examples and final-test tuning weaken independence."
                    },
                    {
                      "id": "errors",
                      "label": "Confusion counts, threshold tradeoff, group counts and shift limitations",
                      "good": true,
                      "why": "A single accuracy percentage hides important limits."
                    },
                    {
                      "id": "governance",
                      "label": "Source/trust checks, model card, human override and stop-use owner",
                      "good": true,
                      "why": "Facts, privacy and decision authority need separate evaluation."
                    },
                    {
                      "id": "hide",
                      "label": "Hide the weak group and report only the 95% headline",
                      "good": false,
                      "why": "Removing inconvenient evidence makes the recommendation misleading."
                    }
                  ],
                  "success": "Assurance pack: task/baseline/costs and preset criteria; leakage audit and frozen manifest; confusion counts, threshold tradeoff, group denominators and shift limits; source/trust checks, model card, human override and stop-use owner. Preserve inconvenient results and the evidence provenance."
                }
              ]
            },
            {
              "stage": 1,
              "brief": "Assemble the baseline, split audit, counts/costs, shift observations, source/trust checks and model card. A go/revise/stop recommendation needs an authorised human owner and conditions that could change the decision.",
              "eyebrow": "AI evidence and assurance lab",
              "prompt": "Recommend an action for the current documented limitations.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><div class=\"artifact\"><div class=\"appBar\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-check\" aria-hidden=\"true\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"m9 14 2 2 4-4\"></path></svg><strong>AI assurance dossier Â· classroom pack</strong></div><div class=\"artifactRow\"><span>Evidence</span><strong>Baseline + split audit + counts/costs + group/shift limits</strong></div><div class=\"artifactRow\"><span>Governance</span><strong>Source/trust checks + model card + human override</strong></div><div class=\"artifactRow\"><span>Current result</span><strong>B recall 2/5; shift evidence limited â†’ revise before wider use</strong></div><div class=\"artifactRow\"><span>Fresh privacy failure</span><strong>Stop affected automation; preserve evidence; approved staff route</strong></div></div><div class=\"board\"><div class=\"actionBank\"><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Go broadly because one sheet says 95%</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Revise the weak-group and shift gaps, retain the manual staff route and independently evaluate before wider use</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Delete weak-group errors before presenting the pack</button></div><button type=\"button\" class=\"primary\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path