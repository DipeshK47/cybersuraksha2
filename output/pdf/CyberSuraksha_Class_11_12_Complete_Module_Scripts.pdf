            {
              "stage": 2,
              "brief": "For real Indian financial cyber fraud, immediately contact bank/payment provider using a trusted channel and promptly report via 1930 or cybercrime.gov.in, with trusted-adult support. Do not delay contact to collect a perfect file. This exercise never submits a report.",
              "eyebrow": "Evidence and verification lab",
              "prompt": "Challenge a promise of guaranteed recovery.",
              "html": "<section><div class=\"lab senior\"><div class=\"senior\"><div class=\"board\"><div class=\"actionBank\"><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Pay the recovery agent because they guarantee success</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Keep reporting promptly through trusted routes; preserve evidence and reject recovery guarantees or fees</button><button type=\"button\" class=\"choice\" aria-pressed=\"false\">Delete all messages because recovery is uncertain</button></div><button type=\"button\" class=\"primary\" disabled=\"\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-check\" aria-hidden=\"true\"><path d=\"M20 6 9 17l-5-5\"></path></svg>Check decision</button></div></div></div></section>",
              "evidence": "<div class=\"evidence\"><h2>Your verification evidence record</h2><ol></ol><p>Structured decisions are checked automatically. Your teacher reviews the actual portfolio, individual defence and reflection. All case records are fictional.</p></div>",
              "interactions": [
                {
                  "type": "ChoiceTask",
                  "choices": [
                    "Pay the recovery agent because they guarantee success",
                    "Keep reporting promptly through trusted routes; preserve evidence and reject recovery guarantees or fees",
                    "Delete all messages because recovery is uncertain"
                  ],
                  "answer": 1,
                  "feedback": "Reporting supports response but does not guarantee recovery. A paid guarantee can be another fraud. Preserve evidence and continue through trusted official channels.",
                  "success": "Recovery-claim response: reject guaranteed-recovery fees, preserve originals and continue trusted bank/official reporting with adult support. No reimbursement or recovery outcome is promised."
                }
              ]
            }
          ],
          "decisionTask": {
            "title": "Kabir builds a response plan",
            "concepts": [
              "Immediate bank/provider contact through a trusted channel",
              "Prompt official reporting and trusted-adult support",
              "Preserve evidence without delaying urgent contact; recovery is not guaranteed"
            ],
            "question": "After an actual suspected financial cyber-fraud loss, what comes first?",
            "choices": [
              "Prompt bank contact, trusted-adult help and official reporting",
              "Wait for every screenshot before contacting anyone",
              "Pay a recovery fee to the sender"
            ],
            "answer": 0,
            "why": "Seek prompt bank/provider help and official reporting; evidence gathering must not delay urgent contact, and a recovery fee can cause further loss."
          }
