# Copy to .env.local (git-ignored). Never commit real values.

# Suraksha Guide LLM (optional). Without a key, the local handbook index answers.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WEB_MODEL=groq/compound-mini

# Demo seeding. Local dev seeds the demo school, admin, and students by default.
# In a production build the demo account is NEVER created unless this is "1".
CYBERSURAKSHA_DEMO_SEED=

# Production bootstrap: creates the first school_admin on an empty database.
# Use these instead of the demo seed when provisioning a real deployment.
CYBERSURAKSHA_SCHOOL_NAME=
CYBERSURAKSHA_ADMIN_NAME=
CYBERSURAKSHA_ADMIN_EMAIL=
CYBERSURAKSHA_ADMIN_PASSWORD=
